    private fun buildShapeShader(): Shader {
        val warm = mixColor(0xFF2E1B1A.toInt(), accent or (0xFF shl 24), 0.25f)
        val core = mixColor(Color.BLACK, warm, gradientPct / 100f)
        return android.graphics.RadialGradient(
            0f, 0f, GR,
            intArrayOf(core, mixColor(Color.BLACK, core, 0.55f), mixColor(Color.BLACK, core, 0.24f), Color.BLACK),
    }

    private fun buildGlowShader(): Shader {
        val rgb = accent and 0xFFFFFF
        return android.graphics.RadialGradient(
            0f, 0f, GR,
            intArrayOf((0x88 shl 24) or rgb, (0x30 shl 24) or rgb, rgb),
            floatArrayOf(0f, 0.38f, 0.85f), Shader.TileMode.CLAMP
        )
    }

 422:     private fun isOverlayServiceEnabled(): Boolean {
 423:         val enabled = Settings.Secure.getString(contentResolver, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES)
 424:             ?: return false
 425:         val cn = ComponentName(this, EdgeService::class.java)
 426:         return enabled.contains(cn.flattenToString()) || enabled.contains(cn.flattenToShortString())
 427:     }

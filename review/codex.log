1801:         const val K = 0.5523f
1802:         const val PRESS_SCALE = 0.92f
1803:         const val TAP_MS = 300L
1804:         const val MODE_IDLE = 0
1805:         const val MODE_EXPANDED = 1
1806:         const val S_QUICK = 0

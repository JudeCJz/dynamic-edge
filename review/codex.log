    private fun startExpand(setVel: Boolean, vw: Float, vh: Float) {
        if (hidden) return
        ensureResources()
        val was = expandedTarget
        expandedTarget = true
        collapsing = false
        // Binder-heavy listener setup is kept off the first animation frames.
        removeCallbacks(startSourcesRunnable)
        if (!sourcesStarted) postDelayed(startSourcesRunnable, 40L)
        regionExpanded = true
        publishRegion()
        wS.stiffness = 420f; wS.dampingRatio = 0.74f
        hS.stiffness = 300f; hS.dampingRatio = 0.78f
        pageS.target = page.toFloat()
    }

    private fun startCollapse(setVel: Boolean, vw: Float, vh: Float) {
        cancelItemLongPress()
        pressed = -1
        removeCallbacks(tickRunnable)
        expandedTarget = false
        collapsing = true
        press.step(dt)
        updateDerived(dt)
        invalidate()
        if (allSettled()) {
            wS.snapTo(wS.target)
            hS.snapTo(hS.target)
            pageS.snapTo(pageS.target)
            press.snapTo(press.target)
            host?.onSettled(true)
            removeCallbacks(tickRunnable)
            if (playing && page == S_MEDIA) postDelayed(tickRunnable, 1000L)
        } else {
            regionExpanded = false
            settledExpanded = false
            stopSources()
            publishRegion()

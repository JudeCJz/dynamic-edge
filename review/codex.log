 119: /** Mini idle bean preview (quarter circle, tip at the bottom-right) for one idle style. */
 120: class IdlePreview(ctx: Context, private val style: String) : View(ctx) {
 121:     var accent = Color.WHITE
 122:         set(v) { field = v; invalidate() }
 123:     var gradient = 60
 124:         set(v) { field = v; invalidate() }
 125:     var selectedStyle = false
 126:         set(v) { field = v; invalidate() }
 127: 
 128:     private val d = resources.displayMetrics.density
 129:     private val path = Path()
 130:     private val p = Paint(Paint.ANTI_ALIAS_FLAG)
 131:     private val rect = RectF()
 132:     private val cream = Color.parseColor("#F2EDE4")
 133: 
 134:     override fun onMeasure(w: Int, h: Int) {
 135:         val s = (44 * d + 0.5f).toInt()
 136:         setMeasuredDimension(s, s)
 137:     }
 138: 
 139:     override fun onDraw(c: Canvas) {
 140:         val w = width.toFloat()
 141:         val h = height.toFloat()
 142:         val s = w * 0.86f
 143:         val x0 = w - s - 0f
 144:         val y0 = h - s
 145:         // quarter circle: bottom-left -> top-right, corner at the bottom-right
 146:         path.rewind()
 147:         path.moveTo(x0, h)
 148:         path.cubicTo(x0, h - s * 0.5523f, w - s * 0.5523f, y0, w, y0)
 149:         path.lineTo(w, h)
 150:         path.close()
 151:         p.style = Paint.Style.FILL
 152:         p.shader = null
 153:         p.color = Color.BLACK
 154:         c.drawPath(path, p)
 155:         val a = (gradient * 2.2f).toInt().coerceIn(0, 255)
 156:         val warm = Color.argb(a, Color.red(accent), Color.green(accent), Color.blue(accent))
 157:         p.shader = RadialGradient(w, h, s, intArrayOf(warm, Color.TRANSPARENT), floatArrayOf(0f, 1f), Shader.TileMode.CLAMP)
 158:         c.drawPath(path, p)
 159:         p.shader = null
 160:         // thin outline so the black bean reads on the black screen
 161:         p.style = Paint.Style.STROKE
 162:         p.strokeWidth = 1f * d
 163:         p.color = if (selectedStyle) Color.WHITE else Color.parseColor("#3A3A3C")
 164:         c.drawPath(path, p)
 165: 
 166:         val cx = w - s * 0.30f
 167:         val cy = h - s * 0.30f
 168:         when (style) {
 169:             "dot" -> {
 170:                 p.style = Paint.Style.FILL
 171:                 p.color = accent
 172:                 c.drawCircle(cx, cy, 3.2f * d, p)
 173:             }
 174:             "arc" -> {
 175:                 p.style = Paint.Style.STROKE
 176:                 p.strokeWidth = 2f * d
 177:                 p.strokeCap = Paint.Cap.ROUND
 178:                 p.color = cream
 179:                 val r = s * 0.42f
 180:                 rect.set(w - r, h - r, w + r, h + r)
 181:                 c.drawArc(rect, 180f, 90f, false, p)
 182:             }
 183:             "battery" -> {
 184:                 p.style = Paint.Style.STROKE
 185:                 p.strokeWidth = 2f * d
 186:                 p.strokeCap = Paint.Cap.ROUND
 187:                 val r = s * 0.42f
 188:                 rect.set(w - r, h - r, w + r, h + r)
 189:                 p.color = Color.parseColor("#3A3A3C")
 190:                 c.drawArc(rect, 180f, 90f, false, p)
 191:                 p.color = accent
 192:                 c.drawArc(rect, 180f, 60f, false, p)
 193:             }
 194:             "clock" -> {
 195:                 p.style = Paint.Style.FILL
 196:                 p.color = cream
 197:                 p.textSize = 8f * d
 198:                 p.textAlign = Paint.Align.CENTER
 199:                 c.drawText("12:30", w - s * 0.40f, h - s * 0.16f, p)
 200:                 p.textAlign = Paint.Align.LEFT
 201:             }
 202:         }
 203:         p.strokeCap = Paint.Cap.BUTT
 204:         p.style = Paint.Style.FILL
 205:     }
 206: }

  22: class EdgeService : AccessibilityService(), EdgeView.Host {
  23: 
  24:     private var wm: WindowManager? = null
  25:     private var edge: EdgeView? = null
  26:     private var lp: WindowManager.LayoutParams? = null
  27:     private var touch: TouchRegion? = null
  28:     private var large = false
  29:     private var imeVisible = false
  30:     private var screenOff = false
  31:     private var receiverRegistered = false
  32: 
  33:     private val receiver = object : BroadcastReceiver() {
  34:         override fun onReceive(context: Context?, intent: Intent?) {
  35:             when (intent?.action) {
  36:                 Intent.ACTION_SCREEN_OFF -> {
  37:                     screenOff = true
  38:                     edge?.collapseImmediately()
  39:                     updateHidden()
  40:                 }
  41:                 Intent.ACTION_SCREEN_ON -> {
  42:                     screenOff = false
  43:                     updateHidden()
  44:                 }
  45:                 Intent.ACTION_USER_PRESENT -> updateHidden()
  46:             }
  47:         }
  48:     }
  49: 
  50:     private var prefListenerRegistered = false
  51:     // strong reference: SharedPreferences only holds listeners weakly
  52:     private val prefListener = SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
  53:         if (key == Prefs.KEY_IDLE_DP || key == Prefs.KEY_OPEN_DP) applySizesFromPrefs()
  54:     }
  55: 
  56:     private fun applySizesFromPrefs() {
  57:         val view = edge ?: return
  58:         val manager = wm ?: return
  59:         val params = lp ?: return
  60:         view.applySizes(Prefs.idleDp(this), Prefs.openDp(this))
  61:         large = false
  62:         val idleWin = idleWindowPx(view)
  63:         params.width = idleWin
  64:         params.height = idleWin
  65:         try {
  66:             manager.updateViewLayout(view, params)
  67:         } catch (e: Throwable) {
  68:         }
  69:     }
  70: 
  71:     private val density: Float get() = resources.displayMetrics.density
  72: 
  73:     override fun onServiceConnected() {
  74:         super.onServiceConnected()
  75:         if (edge != null) return
  76:         AssistControl.disableCornerGesture(this)
  77:         val manager = getSystemService(Context.WINDOW_SERVICE) as WindowManager
  78:         wm = manager
  79: 
  80:         val view = EdgeView(this)
  81:         view.host = this
  82:         view.setTipRadius(readTipRadius())
  83: 
  84:         val idleWin = idleWindowPx(view)
  85:         val params = WindowManager.LayoutParams(
  86:             idleWin,
  87:             idleWin,
  88:             WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
  89:             WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
  90:                 WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
  91:                 WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
  92:                 WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS or
  93:                 WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH or
  94:                 WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
  95:             PixelFormat.TRANSLUCENT
  96:         )
  97:         params.gravity = Gravity.BOTTOM or Gravity.RIGHT
  98:         params.x = 0
  99:         params.y = 0
 100:         params.fitInsetsTypes = 0
 101:         params.fitInsetsSides = 0
 102:         params.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
 103:         params.title = "DynamicEdge"
 104: 
 105:         edge = view
 106:         lp = params
 107:         large = false
 108:         manager.addView(view, params)
 109: 
 110:         touch = TouchRegion.install(view)
 111:         touch?.set(view.currentRegion())
 112: 
 113:         val filter = IntentFilter()
 114:         filter.addAction(Intent.ACTION_SCREEN_OFF)
 115:         filter.addAction(Intent.ACTION_SCREEN_ON)
 116:         filter.addAction(Intent.ACTION_USER_PRESENT)
 117:         registerReceiver(receiver, filter)
 118:         receiverRegistered = true
 119: 
 120:         screenOff = false
 121:         updateHidden()
 122: 
 123:         Prefs.prefs(this).registerOnSharedPreferenceChangeListener(prefListener)
 124:         prefListenerRegistered = true
 125:     }
 126: 
 127:     override fun onAccessibilityEvent(event: AccessibilityEvent?) {
 128:         if (event == null || event.eventType != AccessibilityEvent.TYPE_WINDOWS_CHANGED) return
 129:         val ime = windows.any { it.type == AccessibilityWindowInfo.TYPE_INPUT_METHOD }
 130:         if (ime != imeVisible) {
 131:             imeVisible = ime
 132:             updateHidden()
 133:         }
 134:     }
 135: 
 136:     override fun onInterrupt() {
 137:         // Nothing to interrupt.
 138:     }
 139: 
 140:     override fun onConfigurationChanged(newConfig: Configuration) {
 141:         super.onConfigurationChanged(newConfig)
 142:         val view = edge ?: return
 143:         val manager = wm ?: return
 144:         val params = lp ?: return
 145:         view.setTipRadius(readTipRadius())
 146:         view.collapseImmediately()
 147:         large = false
 148:         val idleWin = idleWindowPx(view)
 149:         params.width = idleWin
 150:         params.height = idleWin
 151:         try {
 152:             manager.updateViewLayout(view, params)
 153:         } catch (e: Throwable) {
 154:         }
 155:     }
 156: 
 157:     override fun onUnbind(intent: Intent?): Boolean {
 158:         teardown()
 159:         return super.onUnbind(intent)
 160:     }
 161: 
 162:     override fun onDestroy() {
 163:         teardown()
 164:         super.onDestroy()
 165:     }
 166: 
 167:     // ------------------------------------------------------------ EdgeView.Host
 168: 
 169:     override fun onNeedLargeWindow() {
 170:         if (large) return
 171:         val view = edge ?: return
 172:         val manager = wm ?: return
 173:         val params = lp ?: return
 174:         val pad = (24f * density).toInt()
 175:         params.width = view.maxOpenWidthPx + pad
 176:         params.height = view.maxOpenHeightPx + pad
 177:         large = true
 178:         try {
 179:             manager.updateViewLayout(view, params)
 180:         } catch (e: Throwable) {
 181:         }
 182:     }
 183: 
 184:     override fun onSettled(expanded: Boolean) {
 185:         if (expanded || !large) return
 186:         val view = edge ?: return
 187:         val manager = wm ?: return
 188:         val params = lp ?: return
 189:         val idleWin = idleWindowPx(view)
 190:         params.width = idleWin
 191:         params.height = idleWin
 192:         large = false
 193:         try {
 194:             manager.updateViewLayout(view, params)
 195:         } catch (e: Throwable) {
 196:         }
 197:     }
 198: 
 199:     override fun onRegionChanged(region: Region) {
 200:         touch?.set(region)
 201:     }
 202: 
 203:     // ------------------------------------------------------------ helpers
 204: 
 205:     private fun idleWindowPx(view: EdgeView): Int = view.idleSizePx + (8f * density).toInt()
 206: 
 207:     private fun updateHidden() {
 208:         val km = getSystemService(Context.KEYGUARD_SERVICE) as? KeyguardManager
 209:         val locked = km?.isKeyguardLocked ?: false
 210:         edge?.setHidden(imeVisible || locked || screenOff)
 211:     }
 212: 
 213:     private fun readTipRadius(): Float {
 214:         if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return 0f
 215:         val dm = getSystemService(Context.DISPLAY_SERVICE) as? DisplayManager ?: return 0f
 216:         val display = dm.getDisplay(Display.DEFAULT_DISPLAY) ?: return 0f
 217:         return display.getRoundedCorner(RoundedCorner.POSITION_BOTTOM_RIGHT)?.radius?.toFloat() ?: 0f
 218:     }
 219: 
 220:     private fun teardown() {
 221:         if (receiverRegistered) {
 222:             receiverRegistered = false
 223:             try {
 224:                 unregisterReceiver(receiver)
 225:             } catch (e: Throwable) {
 226:             }
 227:         }
 228:         if (prefListenerRegistered) {
 229:             prefListenerRegistered = false
 230:             try {
 231:                 Prefs.prefs(this).unregisterOnSharedPreferenceChangeListener(prefListener)
 232:             } catch (e: Throwable) {
 233:             }
 234:         }
 235:         val view = edge ?: return
 236:         edge = null
 237:         touch?.uninstall()
 238:         touch = null
 239:         view.host = null
 240:         view.release()
 241:         try {
 242:             wm?.removeView(view)
 243:         } catch (e: Throwable) {
 244:         }
 245:         lp = null
 246:     }
 247: }

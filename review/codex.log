1453:     // ================================================================ touch
1454: 
1455:     private fun addMove(ev: MotionEvent, rx: Float, ry: Float) {
1456:         val t = vt ?: return
1457:         // The window may resize mid-gesture, so feed the tracker raw (screen) coordinates.
1458:         ev.setLocation(rx, ry)
1459:         t.addMovement(ev)
1460:     }
1461: 
1462:     private fun releaseTracker() {
1463:         vt?.recycle()
1464:         vt = null
1465:     }
1466: 
1467:     private fun cancelItemLongPress() {
1468:         removeCallbacks(longPressRunnable)
1469:     }
1470: 
1471:     override fun onTouchEvent(ev: MotionEvent): Boolean {
1472:         val action = ev.actionMasked
1473:         if (action == MotionEvent.ACTION_OUTSIDE) {
1474:             if (expandedTarget && !gestureActive) startCollapse(false, 0f, 0f)
1475:             return false
1476:         }
1477:         if (hidden) return false
1478:         when (action) {
1479:             MotionEvent.ACTION_DOWN -> return handleDown(ev)
1480:             MotionEvent.ACTION_MOVE -> {
1481:                 if (!gestureActive) return false
1482:                 handleMove(ev)
1483:             }
1484:             MotionEvent.ACTION_UP -> {
1485:                 if (!gestureActive) return false
1486:                 handleUp(ev, false)
1487:             }
1488:             MotionEvent.ACTION_CANCEL -> {
1489:                 if (!gestureActive) return false
1490:                 handleUp(ev, true)
1491:             }
1492:         }
1493:         return true
1494:     }
1495: 
1496:     private fun handleDown(ev: MotionEvent): Boolean {
1497:         val x = ev.x
1498:         val y = ev.y
1499:         val rx = ev.rawX
1500:         val ry = ev.rawY
1501:         ensureResources()
1502:         buildLivePath()
1503:         clipRegion.set(0, 0, max(width, 1), max(height, 1))
1504:         hitRegion.setPath(path, clipRegion)
1505:         if (!hitRegion.contains(x.toInt(), y.toInt())) return false
1506: 
1507:         releaseTracker()
1508:         vt = VelocityTracker.obtain()
1509:         gestureActive = true
1510:         downRawX = rx
1511:         downRawY = ry
1512:         moved = false
1513:         dragMode = 0
1514:         sliderActive = false
1515:         pressed = -1
1516:         longFired = false
1517:         addMove(ev, rx, ry)
1518: 
1519:         if (!expandedTarget) {
1520:             startMode = MODE_IDLE
1521:             // Pay the listener-registration cost during the finger-down, before the expand animation.
1522:             ensureSources()
1523:             press.target = PRESS_SCALE
1524:             requestFrames()
1525:         } else {
1526:             startMode = MODE_EXPANDED
1527:             baseW = wS.value
1528:             baseH = hS.value
1529:             pageStart = pageS.value
1530:             if (contentAlpha > 0.5f) {
1531:                 if (sliderHit(x, y)) {
1532:                     sliderActive = true
1533:                     applySlider(x, y)
1534:                     invalidate()
1535:                 } else {
1536:                     val item = hitItem(x, y)
1537:                     if (item >= 0 && (item > 5 || tAvail[item])) {
1538:                         pressed = item
1539:                         if (item <= 6) postDelayed(longPressRunnable, longPressMs)
1540:                         invalidate()
1541:                     }
1542:                 }
1543:             }
1544:         }
1545:         return true
1546:     }
1547: 
1548:     /** Converts a view point to the local (un-rotated) polar frame of section s. */
1549:     private fun toLocal(x: Float, y: Float, d: Float) {
1550:         val px = x - width
1551:         val py = y - height
1552:         val ang = Math.toRadians((-d * PAGE_DEG).toDouble())
1553:         val cs = cos(ang).toFloat()
1554:         val sn = sin(ang).toFloat()
1555:         lpX = px * cs - py * sn
1556:         lpY = px * sn + py * cs
1557:     }
1558: 
1559:     private fun sliderHit(x: Float, y: Float): Boolean {
1560:         val pos = pageS.value
1561:         if (abs(pos - S_QUICK) > 0.2f) return false
1562:         toLocal(x, y, S_QUICK - pos)
1563:         val r = sqrt(lpX * lpX + lpY * lpY)
1564:         if (abs(r - sliderR) > dp(18f)) return false
1565:         val a = Math.toDegrees(atan2(-lpY.toDouble(), -lpX.toDouble()))
1566:         return a > -4.0 && a < 94.0
1567:     }
1568: 
1569:     private fun applySlider(x: Float, y: Float) {
1570:         toLocal(x, y, S_QUICK - pageS.value)
1571:         val a = Math.toDegrees(atan2(-lpY.toDouble(), -lpX.toDouble())).toFloat()
1572:         val lv = ((a - SL_A0) / (SL_A1 - SL_A0)).coerceIn(0f, 1f)
1573:         bLevel = lv
1574:         if (abs(lv - lastSent) > 0.004f || lv == 0f || lv == 1f) {
1575:             lastSent = lv
1576:             brightness.setLevel(lv)
1577:         }
1578:         invalidate()
1579:     }
1580: 
1581:     private fun hitCircle(i: Int, px: Float, py: Float, infl: Float): Boolean {
1582:         val dx = px - itemCx[i]
1583:         val dy = py - itemCy[i]
1584:         val r = itemRad[i] + infl
1585:         return dx * dx + dy * dy <= r * r
1586:     }
1587: 
1588:     private fun hitItem(x: Float, y: Float): Int {
1589:         if (hitCircle(ID_X, x - width, y - height, dp(8f))) return ID_X
1590:         val pos = pageS.value
1591:         val s = Math.round(pos).coerceIn(0, SECTIONS - 1)
1592:         if (abs(pos - s) > 0.2f) return -1
1593:         toLocal(x, y, s - pos)
1594:         val list = secItems[s]
1595:         for (n in list.indices) {
1596:             val i = list[n]
1597:             if (i in 12..17 && i - 12 >= appCount) continue
1598:             if (i == ID_PLUS && appCount > 0) continue
1599:             if (hitCircle(i, lpX, lpY, dp(3f))) return i
1600:         }
1601:         return -1
1602:     }
1603: 
1604:     private fun handleMove(ev: MotionEvent) {
1605:         val rx = ev.rawX
1606:         val ry = ev.rawY
1607:         addMove(ev, rx, ry)
1608:         if (sliderActive) {
1609:             moved = true
1610:             applySlider(ev.x, ev.y)
1611:             return
1612:         }
1613:         val dx = rx - downRawX
1614:         val dy = ry - downRawY
1615:         if (dragMode == 0) {
1616:             if (sqrt(dx * dx + dy * dy) > touchSlop) {
1617:                 moved = true
1618:                 cancelItemLongPress()
1619:                 if (pressed >= 0) {
1620:                     pressed = -1
1621:                     invalidate()
1622:                 }
1623:                 if (startMode == MODE_IDLE) {
1624:                     if (max(-dx, -dy) > touchSlop) beginDrag(1)
1625:                 } else if (abs(dx) > abs(dy) && abs(dx) > touchSlop) {
1626:                     beginDrag(3)
1627:                 } else if (dy > abs(dx) && dy > touchSlop) {
1628:                     beginDrag(2)
1629:                 }
1630:             }
1631:         }
1632:         if (dragMode != 0) applyDrag(dx, dy)
1633:     }
1634: 
1635:     private fun beginDrag(mode: Int) {
1636:         dragMode = mode
1637:         ensureResources()
1638:         collapsing = false
1639:         settledExpanded = false
1640:         removeCallbacks(tickRunnable)
1641:         if (mode == 1 && !openPicked) pickPage()
1642:         removeCallbacks(startSourcesRunnable)
1643:         if (!sourcesStarted) postDelayed(startSourcesRunnable, 40L)
1644:         regionExpanded = true
1645:         publishRegion()
1646:         updateViz()
1647:         when (mode) {
1648:             1 -> {
1649:                 baseW = idle
1650:                 baseH = idle
1651:             }
1652:             2 -> {
1653:                 baseW = wS.value
1654:                 baseH = hS.value
1655:             }
1656:             else -> {
1657:                 pageStart = pageS.value
1658:                 dragShift = max(0.9f * rad, 1f)
1659:                 pageS.velocity = 0f
1660:             }
1661:         }
1662:         press.target = 1f
1663:         requestFrames()
1664:     }
1665: 
1666:     private fun rubber(v: Float, maxV: Float): Float {
1667:         if (v <= idle) return idle
1668:         if (v <= maxV) return v
1669:         return maxV + min((v - maxV) * 0.3f, dp(18f))
1670:     }
1671: 
1672:     private fun setSizeDirect(w: Float, h: Float) {
1673:         wS.value = w; wS.target = w; wS.velocity = 0f
1674:         hS.value = h; hS.target = h; hS.velocity = 0f
1675:     }
1676: 
1677:     private fun applyDrag(dx: Float, dy: Float) {
1678:         when (dragMode) {
1679:             1 -> setSizeDirect(rubber(baseW - dx, rad), rubber(baseH - dy, rad))
1680:             2 -> {
1681:                 val hh = rubber(baseH - dy, baseH)
1682:                 val fr = (hh - idle) / max(baseH - idle, 1f)
1683:                 setSizeDirect(idle + (baseW - idle) * fr, hh)
1684:             }
1685:             3 -> {
1686:                 val last = (SECTIONS - 1).toFloat()
1687:                 var pos = pageStart - dx / dragShift
1688:                 if (pos < 0f) pos *= 0.3f
1689:                 else if (pos > last) pos = last + (pos - last) * 0.3f
1690:                 pageS.value = pos; pageS.target = pos; pageS.velocity = 0f
1691:             }
1692:         }
1693:         updateDerived(0f)
1694:         invalidate()
1695:     }
1696: 
1697:     private fun finishDrag(vx: Float, vy: Float) {
1698:         val mode = dragMode
1699:         val outward = if (mode == 2) -vy else -(vx + vy) * 0.5f
1700:         val thr = dp(500f)
1701:         val doExpand = when {
1702:             outward > thr -> true
1703:             outward < -thr -> false
1704:             mode == 1 -> progress > 0.33f
1705:             else -> progress > 0.67f
1706:         }
1707:         dragMode = 0
1708:         val vh = -vy
1709:         val vw = if (mode == 2) -vy * (baseW - idle) / max(baseH - idle, 1f) else -vx
1710:         if (doExpand) startExpand(true, vw, vh) else startCollapse(true, vw, vh)
1711:     }
1712: 
1713:     private fun finishPage(dx: Float, vx: Float) {
1714:         val base = Math.round(pageStart).coerceIn(0, SECTIONS - 1)
1715:         val thr = 0.28f * dragShift
1716:         val vthr = dp(500f)
1717:         var target = base
1718:         if (dx < -thr || vx < -vthr) target = base + 1
1719:         else if (dx > thr || vx > vthr) target = base - 1
1720:         target = target.coerceIn(0, SECTIONS - 1)
1721:         if (target != base) userPaged = true
1722:         dragMode = 0
1723:         goToPage(target, -vx / dragShift)
1724:     }
1725: 
1726:     private fun handleUp(ev: MotionEvent, cancel: Boolean) {
1727:         val rx = ev.rawX
1728:         val ry = ev.rawY
1729:         val x = ev.x
1730:         val y = ev.y
1731:         cancelItemLongPress()
1732:         var vx = 0f
1733:         var vy = 0f
1734:         val t = vt
1735:         if (t != null) {
1736:             if (!cancel) addMove(ev, rx, ry)
1737:             t.computeCurrentVelocity(1000)
1738:             vx = t.xVelocity
1739:             vy = t.yVelocity
1740:         }
1741:         releaseTracker()
1742:         val item = pressed
1743:         pressed = -1
1744:         gestureActive = false
1745:         val quick = !moved && (ev.eventTime - ev.downTime) < TAP_MS
1746: 
1747:         if (sliderActive) {
1748:             sliderActive = false
1749:             if (sourcesStarted) bLevel = brightness.level()
1750:         } else if (dragMode == 3) {
1751:             finishPage(if (cancel) 0f else rx - downRawX, if (cancel) 0f else vx)
1752:         } else if (dragMode != 0) {
1753:             finishDrag(if (cancel) 0f else vx, if (cancel) 0f else vy)
1754:         } else if (startMode == MODE_IDLE) {
1755:             press.target = 1f
1756:             if (!cancel && quick) startExpand(false, 0f, 0f)
1757:         } else if (!cancel && !longFired && !moved && item >= 0 && hitItem(x, y) == item) {
1758:             perform(item)
1759:         }
1760:         invalidate()
1761:         requestFrames()
1762:     }
1763: 
1764:     private fun perform(item: Int) {
1765:         when (item) {
1766:             in 0..5 -> {
1767:                 val launched = toggles.toggle(ids[item])
1768:                 refreshToggles()
1769:                 if (launched) startCollapse(false, 0f, 0f)
1770:             }
1771:             6 -> media.playPause()
1772:             7 -> media.prev()
1773:             9 -> media.next()
1774:             ID_ASSIST -> if (AssistControl.launch(context)) startCollapse(false, 0f, 0f)
1775:             ID_X -> startCollapse(false, 0f, 0f)
1776:             in 12..17 -> if (apps.launch(item - 12)) startCollapse(false, 0f, 0f)
1777:             ID_PLUS -> {
1778:                 try {
1779:                     val i = Intent(context, MainActivity::class.java)
1780:                     i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
1781:                     context.startActivity(i)
1782:                 } catch (e: Exception) {
1783:                 }
1784:                 startCollapse(false, 0f, 0f)
1785:             }
1786:         }
1787:     }
1788: 
1789:     private fun onLongPress() {
1790:         val item = pressed
1791:         if (!gestureActive || item !in 0..6) return
1792:         pressed = -1
1793:         longFired = true
1794:         performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
1795:         val launched = if (item == 6) media.openPlayer() else toggles.openSettings(ids[item])
1796:         invalidate()
1797:         if (launched) startCollapse(false, 0f, 0f)
1798:     }
1799: 

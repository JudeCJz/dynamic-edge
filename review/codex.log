 284:     private fun addSlider(
 285:         parent: LinearLayout, label: String, min: Float, max: Float, value: Float,
 286:         fmt: (Float) -> String, preview: String?, save: (Float) -> Unit
 287:     ) {
 288:         val head = LinearLayout(this).apply {
 289:             orientation = LinearLayout.HORIZONTAL
 290:             setPadding(dp(20), dp(12), dp(20), 0)
 291:         }
 292:         val valueView = text(fmt(value), 14f, grey, Typeface.DEFAULT)
 293:         head.addView(text(label, 16f, white, Typeface.DEFAULT), LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
 294:         head.addView(valueView)
 295:         parent.addView(head, matchWrap())
 296: 
 297:         val s = FlatSlider(this).apply {
 298:             this.min = min
 299:             this.max = max
 300:             this.value = value
 301:             accent = Prefs.accent(this@MainActivity)
 302:             setPadding(dp(20), 0, dp(20), 0)
 303:             onStart = { if (preview != null) edit().putString(Prefs.KEY_PREVIEW, preview).apply() }
 304:             onChange = { v -> valueView.text = fmt(v); save(v) }
 305:             onStop = { if (preview != null) edit().putString(Prefs.KEY_PREVIEW, Prefs.PREVIEW_NONE).apply() }
 306:         }
 307:         sliders.add(s)

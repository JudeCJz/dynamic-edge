  45: /**
  46:  * The whole Dynamic Edge widget: shape, content, spring physics and touch handling in one View.
  47:  * The view fills its window and everything is anchored to the bottom-right corner.
  48:  *
  49:  * The open state is a true quarter circle of radius R centred on the corner. Content is laid out in
  50:  * polar coordinates around the corner (angle a measured from the bottom edge, 0..90 deg) as rings
  51:  * with faint slice-tile bands behind them. Sections (pages) are rotated around the corner when paging.
  52:  * To add a section: add an id, an entry in secItems, a layoutXxx() and a drawXxx(), and a branch in drawSection().
  53:  */
  54: class EdgeView(ctx: Context) : View(ctx) {
  55: 
  56:     interface Host {
  57:         fun onSettled(expanded: Boolean)
  58:         fun onRegionChanged(region: Region)
  59:     }
  60: 
  61:     var host: Host? = null
  62: 
  63:     // ---------------------------------------------------------------- metrics
  64:     private val density = resources.displayMetrics.density
  65:     private fun dp(v: Float) = v * density
  66: 
  67:     private var idle = dp(Prefs.idleDp(ctx))

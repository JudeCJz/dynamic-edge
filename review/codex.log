    override fun onTouchEvent(ev: MotionEvent): Boolean {
        val action = ev.actionMasked
        if (action == MotionEvent.ACTION_OUTSIDE) {
            if (expandedTarget && !gestureActive) startCollapse(false, 0f, 0f)
            return false
        }
        val ry = ev.rawY

 461:     /**
 462:      * Applies new idle size / open radius (dp) from the settings app. Keeps the current state: an open
 463:      * widget stays open at the new size (springs snapped), a closed one stays closed.
 464:      */
 465:     fun applySizes(idleDp: Float, openDp: Float) {
 466:         if (gestureActive || dragMode != 0) {
 467:             cancelItemLongPress()
 468:             releaseTracker()
 469:             gestureActive = false
 470:             dragMode = 0
 471:             sliderActive = false
 472:             seekActive = false
 473:             pressed = -1
 474:         }
 475:         idle = dp(idleDp.coerceIn(32f, 80f))
 476:         rad = dp(openDp.coerceIn(170f, 300f))
 477:         layoutAll()
 478:         if (expandedTarget) {
 479:             wS.snapTo(rad)
 480:             hS.snapTo(rad)
 481:         } else {
 482:             wS.snapTo(idle)
 483:             hS.snapTo(idle)
 484:         }
 485:         wS.target = if (expandedTarget) rad else idle
 486:         hS.target = wS.target
 487:         updateDerived(0f)
 488:         publishRegion()
 489:         updateViz()
 490:         invalidate()
 491:     }

 633:     private fun layoutAll() {
 634:         for (b in bands) b.clear()
 635:         nodeS = ceil(rad).toInt() + ceil(dp(3f)).toInt()
 636:         for (i in 0 until SECTIONS) dirty[i] = true
 637:         val hw = min(dp(24.5f), 0.12f * rad - dp(1.5f)).coerceAtLeast(dp(12f))
 638:         val brad = min(dp(20f), hw - dp(2f))
 639: 
 640:         // close X: at the idle bean's centroid (quarter disc centroid = 4/(3 pi) * size)
 641:         val xc = min(0.4244f * idle, 0.16f * rad)
 642:         itemCx[ID_X] = -xc
 643:         itemCy[ID_X] = -xc
 644:         itemRad[ID_X] = dp(17f)
 645: 
 646:         layoutQuick(hw, brad)
 647:         layoutMedia(hw, brad)
 648:         layoutApps(hw, brad)
 649: 
 650:         // force caches to rebuild against the new geometry
 651:         rawTitle = null
 652:         rawArtist = null
 653:         artBmp = null
 654:         lastElapsedSec = -1L
 655:         lastTotalSec = -1L
 656:         for (i in 0..5) appBmp[i] = null
 657:         if (sourcesStarted) {
 658:             refreshMedia()
 659:             refreshApps()
 660:         }
 661:     }

 928:     // ================================================================ region
 929: 
 930:     private fun publishRegion() {
 931:         val ww = width
 932:         val hh = height
 933:         if (hidden) {
 934:             region.setEmpty()
 935:         } else {
 936:             if (ww <= 0 || hh <= 0) return
 937:             val w: Float
 938:             val h: Float
 939:             if (regionExpanded) {
 940:                 w = rad; h = rad
 941:             } else {
 942:                 w = idle; h = idle
 943:             }
 944:             fillPath(regionPath, ww - w, hh - h, w, h, K, tipPx)
 945:             clipRegion.set(0, 0, ww, hh)
 946:             region.setPath(regionPath, clipRegion)
 947:         }
 948:         host?.onRegionChanged(region)
 949:     }
 950: 
 951:     // ================================================================ paging
 952: 
 953:     /** Chooses the section to open on: media if playing, else the last used one. */
 954:     private fun pickPage() {
 955:         openPicked = true
 956:         if (contentAlpha > 0.2f) return // mid-collapse: keep what is on screen
 957:         userPaged = false
 958:         page = if (sourcesStarted && playing) S_MEDIA else lastPage
 959:         pageS.snapTo(page.toFloat())
 960:     }
 961: 
 962:     private fun goToPage(p: Int, vel: Float) {
 963:         page = p
 964:         lastPage = p
 965:         collapsing = false
 966:         settledExpanded = false
 967:         removeCallbacks(tickRunnable)
 968:         pageS.stiffness = 380f; pageS.dampingRatio = 0.86f
 969:         pageS.target = p.toFloat()
 970:         pageS.velocity = vel
 971:         requestFrames()
 972:     }
 973: 
 974:     // ================================================================ animation
 975: 
 976:     private fun startExpand(setVel: Boolean, vw: Float, vh: Float) {
 977:         if (hidden) return
 978:         ensureResources()
 979:         val was = expandedTarget
 980:         expandedTarget = true
 981:         collapsing = false
 982:         settledExpanded = false
 983:         removeCallbacks(tickRunnable)
 984:         if (!openPicked) pickPage()
 985:         // Binder-heavy listener setup is kept off the first animation frames.
 986:         removeCallbacks(startSourcesRunnable)
 987:         if (!sourcesStarted) postDelayed(startSourcesRunnable, 40L)
 988:         regionExpanded = true
 989:         publishRegion()
 990:         wS.stiffness = 420f; wS.dampingRatio = 0.74f
 991:         hS.stiffness = 300f; hS.dampingRatio = 0.78f
 992:         pageS.target = page.toFloat()
 993:         wS.target = rad
 994:         hS.target = rad
 995:         if (setVel) {
 996:             wS.velocity = vw
 997:             hS.velocity = vh
 998:         }
 999:         press.target = 1f
1000:         if (!was) performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY)
1001:         requestFrames()
1002:     }
1003: 
1004:     private fun startCollapse(setVel: Boolean, vw: Float, vh: Float) {
1005:         cancelItemLongPress()
1006:         pressed = -1
1007:         removeCallbacks(tickRunnable)
1008:         expandedTarget = false
1009:         collapsing = true
1010:         settledExpanded = false
1011:         openPicked = false
1012:         wS.stiffness = 520f; wS.dampingRatio = 0.92f
1013:         hS.stiffness = 600f; hS.dampingRatio = 0.92f
1014:         wS.target = idle
1015:         hS.target = idle
1016:         if (setVel) {
1017:             wS.velocity = vw
1018:             hS.velocity = vh
1019:         }
1020:         press.target = 1f
1021:         requestFrames()
1022:     }
1023: 
1024:     private fun requestFrames() {
1025:         if (framePosted) return
1026:         framePosted = true
1027:         Choreographer.getInstance().postFrameCallback(frameCb)
1028:     }
1029: 
1030:     private fun doFrame(frameTimeNanos: Long) {
1031:         framePosted = false
1032:         val dt = if (lastFrameNanos == 0L) {
1033:             1f / 120f
1034:         } else {
1035:             ((frameTimeNanos - lastFrameNanos) * 1e-9f).coerceIn(0f, 1f / 30f)
1036:         }
1037:         lastFrameNanos = frameTimeNanos
1038:         wS.step(dt)
1039:         hS.step(dt)
1040:         pageS.step(dt)
1041:         press.step(dt)
1042:         updateDerived(dt)
1043:         invalidate()
1044:         if (allSettled()) {
1045:             wS.snapTo(wS.target)
1046:             hS.snapTo(hS.target)
1047:             pageS.snapTo(pageS.target)
1048:             press.snapTo(press.target)
1049:             updateDerived(0f)
1050:             lastFrameNanos = 0L
1051:             if (!gestureActive) finishSettle()
1052:         } else {
1053:             requestFrames()
1054:         }
1055:     }
1056: 
1057:     private fun allSettled(): Boolean =
1058:         wS.isSettled(0.3f, 15f) && hS.isSettled(0.3f, 15f) &&
1059:             pageS.isSettled(0.002f, 0.05f) && press.isSettled(0.002f, 0.1f)
1060: 
1061:     private fun finishSettle() {
1062:         if (expandedTarget) {
1063:             regionExpanded = true
1064:             settledExpanded = true
1065:             publishRegion()
1066:             host?.onSettled(true)
1067:             removeCallbacks(tickRunnable)
1068:             if (playing && page == S_MEDIA) postDelayed(tickRunnable, 1000L)
1069:         } else {
1070:             regionExpanded = false
1071:             settledExpanded = false
1072:             stopSources()
1073:             publishRegion()
1074:             host?.onSettled(false)
1075:         }
1076:     }
1077: 
1078:     private fun updateDerived(dt: Float) {
1079:         val span = max(rad - idle, 1f)
1080:         val p = min((wS.value - idle) / span, (hS.value - idle) / span).coerceIn(0f, 1f)
1081:         progress = p
1082:         val t = ((p - 0.55f) / 0.40f).coerceIn(0f, 1f)
1083:         val sm = t * t * (3f - 2f * t)
1084:         contentAlpha = if (collapsing) {
1085:             min(sm, max(0f, contentAlpha - dt / 0.09f))
1086:         } else {
1087:             sm
1088:         }
1089:     }
1090: 
1091:     // ================================================================ draw
1092: 
1093:     private fun buildLivePath() {
1094:         val ps = press.value
1095:         val dw = wS.value * ps
1096:         val dh = hS.value * ps
1097:         val ox = width - dw
1098:         val oy = height - dh
1099:         val pressGlow = ((1f - ps) / (1f - PRESS_SCALE)).coerceIn(0f, 1f)
1100:         glow = max(max(pressGlow, if (dragMode != 0 || sliderActive) 0.85f else 0f), progress * 0.4f)
1101:         // Static shape: keep the Path objects untouched so HWUI reuses their cached geometry.
1102:         if (dw == lastDw && dh == lastDh && width == lastW && height == lastH && tipPx == lastTip) return
1103:         lastDw = dw; lastDh = dh; lastW = width; lastH = height; lastTip = tipPx
1104:         fillPath(path, ox, oy, dw, dh, K, tipPx)
1105:         rimPath.rewind()
1106:         rimPath.moveTo(ox, height.toFloat())
1107:         rimPath.cubicTo(ox, height - K * dh, width - K * dw, oy, width.toFloat(), oy)
1108:         val r = max(dw, dh) * 1.15f / GR
1109:         gradScale = r
1110:         gradMatrix.setTranslate(-width.toFloat(), -height.toFloat())
1111:         gradMatrix.postScale(1f / r, 1f / r)
1112:         path.transform(gradMatrix, unitPath)
1113:     }
1114: 
1115:     override fun onDraw(c: Canvas) {
1116:         buildLivePath()
1117:         val g = glow
1118:         c.save()
1119:         c.translate(width.toFloat(), height.toFloat())
1120:         c.scale(gradScale, gradScale)
1121:         c.drawPath(unitPath, shapePaint)
1122:         if (g > 0.01f) {
1123:             glowPaint.alpha = (255f * g + 0.5f).toInt()
1124:             c.drawPath(unitPath, glowPaint)
1125:         }
1126:         c.restore()
1127:         val ra = RIM_REST_A + (RIM_HOT_A - RIM_REST_A) * g
1128:         val rr = (255f + (0xFF - 255f) * g).toInt()
1129:         val rg = (255f + (0x4B - 255f) * g).toInt()
1130:         val rb = (255f + (0x3E - 255f) * g).toInt()
1131:         rimPaint.color = Color.argb((255f * ra + 0.5f).toInt(), rr, rg, rb)
1132:         c.drawPath(rimPath, rimPaint)
1133:         val a = contentAlpha
1134:         if (a > 0.004f && resourcesReady) drawContent(c, a)
1135:     }
1136: 
1137:     private fun drawContent(c: Canvas, a: Float) {
1138:         if (!c.isHardwareAccelerated) {
1139:             drawContentDirect(c, a)
1140:             return
1141:         }
1142:         val off = (1f - a) * dp(16f)
1143:         // content grows with the melting shape, so no clip is needed
1144:         val cs = (min(wS.value, hS.value) / rad).coerceIn(0f, 1f)
1145:         val pos = pageS.value
1146:         val s = nodeS
1147:         val sf = s.toFloat()
1148:         val w = width
1149:         val h = height
1150:         for (i in 0 until SECTIONS) {
1151:             val d = i - pos
1152:             val fa = (1f - abs(d) * 1.2f).coerceIn(0f, 1f)
1153:             if (fa <= 0.004f) continue
1154:             var n = nodes[i]
1155:             if (n == null) {
1156:                 n = RenderNode("edgeSection$i")
1157:                 n.setUseCompositingLayer(true, null)
1158:                 n.setClipToBounds(true)
1159:                 nodes[i] = n
1160:             }
1161:             n.setPosition(w - s, h - s, w, h)
1162:             if (dirty[i]) {
1163:                 val rc = n.beginRecording(s, s)
1164:                 try {
1165:                     rc.translate(sf, sf)
1166:                     drawSection(rc, i, 1f)
1167:                 } finally {
1168:                     n.endRecording()
1169:                 }
1170:                 dirty[i] = false
1171:             }
1172:             n.setPivotX(sf)
1173:             n.setPivotY(sf)
1174:             n.setRotationZ(d * PAGE_DEG)
1175:             n.setAlpha(a * fa)
1176:             n.setScaleX(cs)
1177:             n.setScaleY(cs)
1178:             n.setTranslationX(off)
1179:             n.setTranslationY(off)
1180:             c.drawRenderNode(n)
1181:         }
1182:         c.save()
1183:         c.translate(w + off, h + off)
1184:         c.scale(cs, cs)
1185:         drawDots(c, a)
1186:         drawClose(c, a)
1187:         c.restore()
1188:     }
1189: 
1190:     private fun drawContentDirect(c: Canvas, a: Float) {
1191:         c.save()
1192:         c.clipPath(path)
1193:         val off = (1f - a) * dp(16f)
1194:         val s = 0.96f + 0.04f * a
1195:         c.translate(width + off, height + off)
1196:         c.scale(s, s)
1197:         val pos = pageS.value
1198:         for (i in 0 until SECTIONS) {
1199:             val d = i - pos
1200:             val fa = (1f - abs(d) * 1.2f).coerceIn(0f, 1f)
1201:             if (fa <= 0.004f) continue
1202:             c.save()
1203:             c.rotate(d * PAGE_DEG)
1204:             drawSection(c, i, a * fa)
1205:             c.restore()
1206:         }
1207:         drawDots(c, a)
1208:         drawClose(c, a)
1209:         c.restore()
1210:     }
1211: 
1212:     private fun drawSection(c: Canvas, i: Int, a: Float) {
1213:         tilePaint.alpha = (255f * 0.045f * a + 0.5f).toInt()
1214:         val list = bands[i]
1215:         for (b in list.indices) {
1216:             val tiles = list[b]
1217:             for (t in tiles.indices) c.drawPath(tiles[t], tilePaint)
1218:         }
1219:         when (i) {
1220:             S_QUICK -> drawQuick(c, a)
1221:             S_MEDIA -> drawMedia(c, a)
1222:             S_APPS -> drawApps(c, a)
1223:         }
1224:     }
1225: 
1226:     private fun drawDots(c: Canvas, a: Float) {
1227:         // Dots live in the free band between the close X and the inner ring, so they never
1228:         // collide with the brightness slider / progress arc on the outer edge.
1229:         val xd = kotlin.math.hypot(itemCx[ID_X], itemCy[ID_X])
1230:         val rd = max(rad * 0.26f, xd + dp(26f))
1231:         val stepDeg = Math.toDegrees((dp(10f) / rd).toDouble()).toFloat()
1232:         val r = dp(2.5f)
1233:         val ai = (255f * a + 0.5f).toInt()
1234:         fill.color = C_DOT
1235:         fill.alpha = ai
1236:         val mid = (SECTIONS - 1) / 2f
1237:         for (i in 0 until SECTIONS) {
1238:             val ang = Math.toRadians((45f + (i - mid) * stepDeg).toDouble())
1239:             c.drawCircle(-rd * cos(ang).toFloat(), -rd * sin(ang).toFloat(), r, fill)
1240:         }
1241:         val pos = pageS.value.coerceIn(0f, (SECTIONS - 1).toFloat())
1242:         val dist = abs(pos - Math.round(pos).toFloat()) // 0..0.5
1243:         val aPos = 45f + (pos - mid) * stepDeg
1244:         // pill length along the arc: 14 dp at rest on a page, shrinking to a dot between pages
1245:         val sweepDeg = Math.toDegrees(((dp(14f) - dp(5f)) * (1f - dist * 2f) / rd).toDouble()).toFloat()
1246:         arcPaint.color = C_RED
1247:         arcPaint.alpha = ai
1248:         arcPaint.strokeWidth = dp(5f)
1249:         if (sweepDeg > 0.3f) {
1250:             ovalA.set(-rd, -rd, rd, rd)
1251:             c.drawArc(ovalA, 180f + aPos - sweepDeg / 2f, sweepDeg, false, arcPaint)
1252:         } else {
1253:             val ang = Math.toRadians(aPos.toDouble())
1254:             fill.color = C_RED
1255:             fill.alpha = ai
1256:             c.drawCircle(-rd * cos(ang).toFloat(), -rd * sin(ang).toFloat(), r, fill)
1257:         }
1258:     }
1259: 
1260:     private fun drawClose(c: Canvas, a: Float) {
1261:         val cx = itemCx[ID_X]
1262:         val cy = itemCy[ID_X]
1263:         val sc = 0.6f + 0.4f * a
1264:         val ai = (255f * a + 0.5f).toInt()
1265:         c.save()
1266:         c.scale(sc * (if (pressed == ID_X) PRESS_SCALE else 1f), sc * (if (pressed == ID_X) PRESS_SCALE else 1f), cx, cy)
1267:         fill.color = C_FILL
1268:         fill.alpha = ai
1269:         c.drawCircle(cx, cy, itemRad[ID_X], fill)
1270:         if (pressed == ID_X) {
1271:             ringPaint.alpha = ai
1272:             c.drawCircle(cx, cy, itemRad[ID_X] + dp(3f), ringPaint)
1273:         }
1274:         linePaint.color = Color.WHITE
1275:         linePaint.alpha = ai
1276:         linePaint.strokeWidth = dp(1.8f)
1277:         val h = dp(7f)
1278:         c.drawLine(cx - h, cy - h, cx + h, cy + h, linePaint)
1279:         c.drawLine(cx - h, cy + h, cx + h, cy - h, linePaint)
1280:         c.restore()
1281:     }
1282: 
1283:     private fun drawBtn(c: Canvas, i: Int, fillColor: Int, res: Int, black: Boolean, a: Float, ba: Float) {
1284:         val cx = itemCx[i]
1285:         val cy = itemCy[i]
1286:         val ps = pressed == i
1287:         if (ps) {
1288:             c.save()
1289:             c.scale(PRESS_SCALE, PRESS_SCALE, cx, cy)
1290:         }
1291:         val ai = (255f * ba + 0.5f).toInt()
1292:         if (fillColor != 0) {
1293:             fill.color = fillColor
1294:             fill.alpha = ai
1295:             c.drawCircle(cx, cy, itemRad[i], fill)
1296:         }
1297:         if (ps) {
1298:             ringPaint.alpha = (255f * a + 0.5f).toInt()
1299:             c.drawCircle(cx, cy, itemRad[i] + dp(3f), ringPaint)
1300:         }
1301:         if (res != 0) {
1302:             val ic = icon(res, black)
1303:             ic.bounds = iconRect[i]
1304:             ic.alpha = ai
1305:             ic.draw(c)
1306:         }
1307:         if (ps) c.restore()
1308:     }
1309: 
1310:     private fun drawQuick(c: Canvas, a: Float) {
1311:         for (i in secItems[S_QUICK]) {
1312:             if (i <= 5) {
1313:                 val on = tOn[i]
1314:                 drawBtn(c, i, if (on) Color.WHITE else C_FILL, tIcon[i], on, a, (if (tAvail[i]) 1f else 0.35f) * a)
1315:             } else {
1316:                 drawBtn(c, i, C_FILL, R.drawable.ic_mic, false, a, a)
1317:             }
1318:         }
1319:         // brightness arc slider
1320:         val ai = (255f * a + 0.5f).toInt()
1321:         arcPaint.strokeWidth = dp(4f)
1322:         arcPaint.color = C_TRACK
1323:         arcPaint.alpha = ai
1324:         c.drawArc(sliderOval, 180f + SL_A0, SL_A1 - SL_A0, false, arcPaint)
1325:         val lv = bLevel.coerceIn(0f, 1f)
1326:         if (lv > 0.001f) {
1327:             arcPaint.color = C_RED
1328:             arcPaint.alpha = ai
1329:             c.drawArc(sliderOval, 180f + SL_A0, (SL_A1 - SL_A0) * lv, false, arcPaint)
1330:         }
1331:         val ang = Math.toRadians((SL_A0 + (SL_A1 - SL_A0) * lv).toDouble())
1332:         val tx = -sliderR * cos(ang).toFloat()
1333:         val ty = -sliderR * sin(ang).toFloat()
1334:         val tr = dp(8f) * (if (sliderActive) 1.15f else 1f)
1335:         if (sliderActive) {
1336:             ringPaint.alpha = ai
1337:             c.drawCircle(tx, ty, tr + dp(2.5f), ringPaint)
1338:         }
1339:         fill.color = Color.WHITE
1340:         fill.alpha = ai
1341:         c.drawCircle(tx, ty, tr, fill)
1342:     }

   1: package com.dynedge
   2: 
   3: import android.content.ComponentName
   4: import android.content.Context
   5: import android.content.Intent
   6: import android.content.SharedPreferences
   7: import android.provider.MediaStore
   8: 
   9: object Prefs {
  10:     const val NAME = "edge"
  11:     const val KEY_IDLE_DP = "idle_dp"
  12:     const val KEY_OPEN_DP = "open_dp"
  13:     const val KEY_APPS = "apps"
  14:     const val IDLE_MIN = 32f
  15:     const val IDLE_MAX = 80f
  16:     const val IDLE_DEF = 48f
  17:     const val OPEN_MIN = 170f
  18:     const val OPEN_MAX = 300f
  19:     const val OPEN_DEF = 216f
  20:     const val MAX_APPS = 6
  21: 
  22:     fun prefs(ctx: Context): SharedPreferences = ctx.getSharedPreferences(NAME, Context.MODE_PRIVATE)
  23: 
  24:     fun idleDp(ctx: Context): Float =
  25:         prefs(ctx).getFloat(KEY_IDLE_DP, IDLE_DEF).coerceIn(IDLE_MIN, IDLE_MAX)
  26: 
  27:     fun openDp(ctx: Context): Float =
  28:         prefs(ctx).getFloat(KEY_OPEN_DP, OPEN_DEF).coerceIn(OPEN_MIN, OPEN_MAX)
  29: 
  30:     fun setIdleDp(ctx: Context, v: Float) {
  31:         prefs(ctx).edit().putFloat(KEY_IDLE_DP, v.coerceIn(IDLE_MIN, IDLE_MAX)).apply()
  32:     }
  33: 
  34:     fun setOpenDp(ctx: Context, v: Float) {
  35:         prefs(ctx).edit().putFloat(KEY_OPEN_DP, v.coerceIn(OPEN_MIN, OPEN_MAX)).apply()
  36:     }
  37: 
  38:     // ---------------------------------------------------------------- looks and feel
  39:     const val KEY_ACCENT = "accent"            // Int ARGB
  40:     const val KEY_GRADIENT = "gradient"        // Int 0..100, warmth/strength of the corner gradient
  41:     const val KEY_RIM = "rim"                  // Boolean, thin border along the curve
  42:     const val KEY_GLOW = "glow"                // Boolean, accent glow on touch / open
  43:     const val KEY_BANDS = "bands"              // Boolean, faint ring tiles behind items (off by default)
  44:     const val KEY_SPEED = "speed"              // Int 0..100, 0 = slow and fluid, 100 = snappy
  45:     const val KEY_BOUNCE = "bounce"            // Int 0..100, 0 = no overshoot, 100 = very bouncy
  46:     const val KEY_HAPTICS = "haptics"          // Boolean
  47:     const val KEY_IDLE_STYLE = "idle_style"    // String, one of IDLE_STYLES
  48:     const val KEY_VISUALIZER = "visualizer"    // Boolean, music bars on the idle bean while playing
  49:     const val KEY_PREVIEW = "preview"          // String "", "idle" or "open"; transient, set by the settings screen
  50: 
  51:     val ACCENTS = intArrayOf(
  52:         0xFFFF4B3E.toInt(), // red (default)
  53:         0xFFFF9F0A.toInt(), // orange
  54:         0xFFFFD60A.toInt(), // yellow
  55:         0xFF30D158.toInt(), // green
  56:         0xFF0A84FF.toInt(), // blue
  57:         0xFFBF5AF2.toInt(), // purple
  58:         0xFFFF375F.toInt(), // pink
  59:         0xFFF2EDE4.toInt()  // cream / white
  60:     )
  61:     val IDLE_STYLES = arrayOf("plain", "dot", "arc", "battery", "clock")
  62:     const val PREVIEW_NONE = ""
  63:     const val PREVIEW_IDLE = "idle"
  64:     const val PREVIEW_OPEN = "open"
  65: 
  66:     fun accent(ctx: Context): Int = prefs(ctx).getInt(KEY_ACCENT, ACCENTS[0])
  67:     fun gradient(ctx: Context): Int = prefs(ctx).getInt(KEY_GRADIENT, 60).coerceIn(0, 100)
  68:     fun rim(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_RIM, true)
  69:     fun glow(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_GLOW, true)
  70:     fun bands(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_BANDS, false)
  71:     fun speed(ctx: Context): Int = prefs(ctx).getInt(KEY_SPEED, 50).coerceIn(0, 100)
  72:     fun bounce(ctx: Context): Int = prefs(ctx).getInt(KEY_BOUNCE, 40).coerceIn(0, 100)
  73:     fun haptics(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_HAPTICS, true)
  74:     fun idleStyle(ctx: Context): String =
  75:         prefs(ctx).getString(KEY_IDLE_STYLE, "dot")?.takeIf { it in IDLE_STYLES } ?: "dot"
  76:     fun visualizer(ctx: Context): Boolean = prefs(ctx).getBoolean(KEY_VISUALIZER, true)
  77:     fun preview(ctx: Context): String = prefs(ctx).getString(KEY_PREVIEW, PREVIEW_NONE) ?: PREVIEW_NONE
  78: 
  79:     /** Stiffness multiplier from KEY_SPEED: 0.55 (fluid) .. 1.6 (snappy). */
  80:     fun stiffnessScale(ctx: Context): Float = 0.55f + 1.05f * speed(ctx) / 100f
  81:     /** Damping ratio for open motion from KEY_BOUNCE: 0.98 (none) .. 0.55 (bouncy). */
  82:     fun openDamping(ctx: Context): Float = 0.98f - 0.43f * bounce(ctx) / 100f
  83: 
  84:     fun resetLooks(ctx: Context) {
  85:         prefs(ctx).edit()
  86:             .remove(KEY_ACCENT).remove(KEY_GRADIENT).remove(KEY_RIM).remove(KEY_GLOW).remove(KEY_BANDS)
  87:             .remove(KEY_SPEED).remove(KEY_BOUNCE).remove(KEY_HAPTICS).remove(KEY_IDLE_STYLE)
  88:             .remove(KEY_VISUALIZER)
  89:             .apply()
  90:     }
  91: 
  92:     fun apps(ctx: Context): List<ComponentName> {
  93:         val s = prefs(ctx).getString(KEY_APPS, null) ?: return defaultApps(ctx)
  94:         val out = ArrayList<ComponentName>()
  95:         for (part in s.split("|")) {
  96:             if (part.isEmpty()) continue
  97:             val c = ComponentName.unflattenFromString(part) ?: continue
  98:             if (c !in out) out.add(c)
  99:             if (out.size >= MAX_APPS) break
 100:         }
 101:         return out
 102:     }
 103: 
 104:     fun setApps(ctx: Context, list: List<ComponentName>) {
 105:         val s = list.distinct().take(MAX_APPS).joinToString("|") { it.flattenToString() }
 106:         prefs(ctx).edit().putString(KEY_APPS, s).apply()
 107:     }
 108: 
 109:     private fun defaultApps(ctx: Context): List<ComponentName> {
 110:         val pm = ctx.packageManager
 111:         val intents = listOf(
 112:             Intent(Intent.ACTION_DIAL),
 113:             Intent(MediaStore.INTENT_ACTION_STILL_IMAGE_CAMERA),
 114:             Intent.makeMainSelectorActivity(Intent.ACTION_MAIN, Intent.CATEGORY_APP_BROWSER),
 115:             Intent.makeMainSelectorActivity(Intent.ACTION_MAIN, Intent.CATEGORY_APP_MESSAGING),
 116:             Intent.makeMainSelectorActivity(Intent.ACTION_MAIN, Intent.CATEGORY_APP_GALLERY),
 117:             Intent(android.provider.Settings.ACTION_SETTINGS)
 118:         )
 119:         val out = ArrayList<ComponentName>()
 120:         for (i in intents) {
 121:             val ai = try {
 122:                 pm.resolveActivity(i, 0)?.activityInfo
 123:             } catch (e: Exception) {
 124:                 null
 125:             } ?: continue
 126:             if (ai.packageName == "android") continue
 127:             val c = ComponentName(ai.packageName, ai.name)
 128:             if (c !in out) out.add(c)
 129:         }
 130:         return out
 131:     }
 132: }

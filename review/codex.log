 430:     fun collapseImmediately() {
 431:         if (framePosted) {
 432:             Choreographer.getInstance().removeFrameCallback(frameCb)
 433:             framePosted = false
 434:         }
 435:         lastFrameNanos = 0L
 436:         cancelItemLongPress()
 437:         removeCallbacks(tickRunnable)
 438:         releaseTracker()
 439:         gestureActive = false
 440:         dragMode = 0
 441:         sliderActive = false
 442:         pressed = -1
 443:         expandedTarget = false
 444:         collapsing = true
 445:         settledExpanded = false
 446:         openPicked = false
 447:         wS.snapTo(idle)
 448:         hS.snapTo(idle)
 449:         pageS.snapTo(page.toFloat())
 450:         press.snapTo(1f)
 451:         progress = 0f
 452:         contentAlpha = 0f
 453:         stopSources()
 454:         regionExpanded = false
 455:         publishRegion()
 456:         host?.onSettled(false)
 457:         updateViz()
 458:         invalidate()
 459:     }

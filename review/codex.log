 563:     // ================================================================ geometry
 564: 
 565:     private fun fillPath(p: Path, ox: Float, oy: Float, w: Float, h: Float, k: Float, tip: Float) {
 566:         p.rewind()
 567:         val right = ox + w
 568:         val bottom = oy + h
 569:         p.moveTo(ox, bottom)
 570:         p.cubicTo(ox, bottom - k * h, right - k * w, oy, right, oy)
 571:         val t = min(tip, min(w, h))
 572:         if (t > 0.5f) {
 573:             p.lineTo(right, bottom - t)
 574:             arcRect.set(right - 2f * t, bottom - 2f * t, right, bottom)
 575:             p.arcTo(arcRect, 0f, 90f)
 576:         } else {
 577:             p.lineTo(right, bottom)
 578:         }
 579:         p.lineTo(ox, bottom)
 580:         p.close()
 581:     }
 582: 
 583:     private fun place(i: Int, rc: Float, aDeg: Float, itemR: Float) {
 584:         // shrink the ring radius if the item would not fit inside the curve with a 6 dp margin
 585:         val r = min(rc, rad - dp(6f) - itemR)
 586:         val a = Math.toRadians(aDeg.toDouble())
 587:         itemCx[i] = -r * cos(a).toFloat()
 588:         itemCy[i] = -r * sin(a).toFloat()
 589:         itemRad[i] = itemR
 590:         val half = (itemR * 0.475f).toInt().coerceAtLeast(1)
 591:         val cx = itemCx[i].toInt()
 592:         val cy = itemCy[i].toInt()
 593:         iconRect[i].set(cx - half, cy - half, cx + half, cy + half)
 594:     }
 595: 
 596:     private fun addBand(sec: Int, r1: Float, r2: Float, a0: Float, a1: Float, n: Int) {
 597:         val inset = dp(1f)
 598:         val ri = r1 + inset
 599:         val ro = r2 - inset
 600:         if (ro <= ri + dp(2f)) return
 601:         val gapHalf = (dp(3f) + dp(2f)) / 2f
 602:         val oOut = Math.toDegrees((gapHalf / ro).toDouble()).toFloat()
 603:         val oIn = Math.toDegrees((gapHalf / ri).toDouble()).toFloat()
 604:         val outer = RectF(-ro, -ro, ro, ro)
 605:         val inner = RectF(-ri, -ri, ri, ri)
 606:         val span = (a1 - a0) / n
 607:         val arr = Array(n) { Path() }
 608:         for (t in 0 until n) {
 609:             val s = a0 + t * span
 610:             val e = s + span
 611:             val p = arr[t]
 612:             p.arcTo(outer, 180f + s + oOut, span - 2f * oOut, true)
 613:             p.arcTo(inner, 180f + e - oIn, -(span - 2f * oIn), false)
 614:             p.close()
 615:         }
 616:         bands[sec].add(arr)
 617:     }
 618: 
 619:     private fun arcPath(p: Path, r: Float, a0: Float, a1: Float) {
 620:         ovalA.set(-r, -r, r, r)
 621:         p.rewind()
 622:         p.arcTo(ovalA, 180f + a0, a1 - a0, true)
 623:     }
 624: 
 625:     private fun markItemDirty(item: Int) {
 626:         when (item) {
 627:             in 0..5, ID_ASSIST, ID_SUN -> dirty[S_QUICK] = true
 628:             6, 7, 9 -> dirty[S_MEDIA] = true
 629:             in 12..ID_PLUS -> dirty[S_APPS] = true
 630:         }
 631:     }
 632: 
 633:     private fun layoutAll() {
 634:         for (b in bands) b.clear()
 635:         nodeS = ceil(rad).toInt() + ceil(dp(3f)).toInt()
 636:         for (i in 0 until SECTIONS) dirty[i] = true
 637:         val hw = min(dp(24.5f), 0.12f * rad - dp(1.5f)).coerceAtLeast(dp(12f))
 638:         val brad = min(dp(20f), hw - dp(2f))
 639: 
 640:         // close X: at the idle bean's centroid (quarter disc centroid = 4/(3 pi) * size)
 641:         val xc = min(0.4244f * idle, 0.16f * rad)
 642:         itemCx[ID_X] = -xc
 643:         itemCy[ID_X] = -xc
 644:         itemRad[ID_X] = dp(17f)
 645: 
 646:         layoutQuick(hw, brad)
 647:         layoutMedia(hw, brad)
 648:         layoutApps(hw, brad)
 649: 
 650:         // force caches to rebuild against the new geometry
 651:         rawTitle = null
 652:         rawArtist = null
 653:         artBmp = null
 654:         lastElapsedSec = -1L
 655:         lastTotalSec = -1L
 656:         for (i in 0..5) appBmp[i] = null
 657:         if (sourcesStarted) {
 658:             refreshMedia()
 659:             refreshApps()
 660:         }
 661:     }
 662: 
 663:     private fun layoutQuick(hw: Float, brad: Float) {
 664:         val ri = 0.42f * rad
 665:         val rm = 0.66f * rad
 666:         val half = ri * sin(Math.toRadians(12.5)).toFloat()
 667:         val radIn = min(brad, half - dp(1.5f)).coerceAtLeast(dp(10f))
 668:         place(4, ri, 20f, radIn)
 669:         place(ID_ASSIST, ri, 45f, radIn)
 670:         place(5, ri, 70f, radIn)
 671:         for (k in 0..3) place(k, rm, MID_A[k], brad)
 672:         sliderR = min(0.88f * rad, rad - dp(14f))
 673:         sliderOval.set(-sliderR, -sliderR, sliderR, sliderR)
 674:         addBand(S_QUICK, ri - hw, ri + hw, 4f, 86f, 3)
 675:         addBand(S_QUICK, rm - hw, rm + hw, 4f, 86f, 4)
 676:         addBand(S_QUICK, sliderR - dp(18f), min(sliderR + dp(18f), rad - dp(2.5f)), 4f, 86f, 1)
 677:     }
 678: 
 679:     private fun layoutMedia(hw: Float, brad: Float) {
 680:         val artD = (0.30f * rad).coerceIn(dp(52f), dp(76f))
 681:         artRad = artD / 2f
 682:         val rArt = 0.52f * rad
 683:         place(6, rArt, 45f, artRad)
 684:         place(7, rArt, 14f, min(brad, dp(18f)))
 685:         place(9, rArt, 76f, min(brad, dp(18f)))
 686:         val artEdge = sqrt(itemCx[6] * itemCx[6] + itemCy[6] * itemCy[6]) + artRad
 687:         val artistR = max(0.72f * rad, artEdge + dp(8f))
 688:         val titleR = artistR + dp(15f)
 689:         arcR = min(max(0.88f * rad, titleR + dp(27f)), rad - dp(10f))
 690:         arcOval.set(-arcR, -arcR, arcR, arcR)
 691:         arcPath(titlePath, titleR, 20f, 70f)
 692:         arcPath(artistPath, artistR, 20f, 70f)
 693:         titleLen = titleR * Math.toRadians(50.0).toFloat()
 694:         artistLen = artistR * Math.toRadians(50.0).toFloat()
 695: 
 696:         val ih = dp(10f).toInt()
 697:         artIconRect.set(
 698:             (itemCx[6] - ih).toInt(), (itemCy[6] - ih).toInt(),
 699:             (itemCx[6] + ih).toInt(), (itemCy[6] + ih).toInt()
 700:         )
 701:         val ph = dp(9f).toInt()
 702:         playIconRect.set(
 703:             (itemCx[6] - ph).toInt(), (itemCy[6] - ph).toInt(),
 704:             (itemCx[6] + ph).toInt(), (itemCy[6] + ph).toInt()
 705:         )
 706: 
 707:         val tr = arcR - dp(22f)
 708:         val a8 = Math.toRadians(8.0)
 709:         val a82 = Math.toRadians(82.0)
 710:         elapsedX = -tr * cos(a8).toFloat()
 711:         elapsedY = -tr * sin(a8).toFloat() + dp(3.5f)
 712:         totalX = -tr * cos(a82).toFloat()
 713:         totalY = -tr * sin(a82).toFloat() + dp(3.5f)
 714: 
 715:         val bandHalf = max(artRad, dp(18f)) + dp(4f)
 716:         addBand(S_MEDIA, rArt - bandHalf, rArt + bandHalf, 4f, 86f, 3)
 717:         addBand(S_MEDIA, artistR - dp(5f), titleR + dp(14f), 14f, 76f, 1)
 718:         addBand(S_MEDIA, arcR - dp(11f), min(arcR + dp(11f), rad - dp(2.5f)), 4f, 86f, 1)
 719:     }
 720: 
 721:     private fun layoutApps(hw: Float, brad: Float) {
 722:         val ri = 0.44f * rad
 723:         val ro = 0.70f * rad
 724:         place(12, ri, 25f, brad)
 725:         place(13, ri, 65f, brad)
 726:         for (k in 0..3) place(14 + k, ro, MID_A[k], brad)
 727:         place(ID_PLUS, 0.60f * rad, 45f, dp(22f))
 728:         val ph = dp(9f).toInt()
 729:         plusRect.set(
 730:             (itemCx[ID_PLUS] - ph).toInt(), (itemCy[ID_PLUS] - ph).toInt(),
 731:             (itemCx[ID_PLUS] + ph).toInt(), (itemCy[ID_PLUS] + ph).toInt()
 732:         )
 733:         addBand(S_APPS, ri - hw, ri + hw, 4f, 86f, 2)
 734:         addBand(S_APPS, ro - hw, ro + hw, 4f, 86f, 4)
 735:     }

  69:     private var tipPx = 0f
  70: 
  71:     val idleSizePx: Int get() = ceil(idle).toInt()
  72:     val maxOpenWidthPx: Int get() = ceil(rad).toInt()
  73:     val maxOpenHeightPx: Int get() = ceil(rad).toInt()
  74: 
  75:     // ---------------------------------------------------------------- state
  76:     private val wS = Spring(idle, 420f, 0.74f)
  77:     private val hS = Spring(idle, 300f, 0.78f)
  78:     private val pageS = Spring(0f, 380f, 0.86f)
  79:     private val press = Spring(1f, 700f, 0.75f)
  80: 
  81:     private var page = S_QUICK
  82:     private var lastPage = S_QUICK
  83:     private var openPicked = false
  84:     private var userPaged = false
  85:     private var pageStart = 0f
  86:     private var dragShift = 0f
  87: 
  88:     private var progress = 0f
  89:     private var contentAlpha = 0f
  90:     private var collapsing = true
  91:     private var expandedTarget = false
  92:     private var settledExpanded = false
  93:     private var regionExpanded = false
  94:     private var hidden = false
  95:     private var sourcesStarted = false
  96: 
  97:     val isExpanded: Boolean get() = expandedTarget
  98: 
  99:     // Items: 19 brightness sun, 0..5 toggles, 6 media art (play/pause, long-press opens player), 7 prev, 9 next,
 100:     // 10 assistant, 11 close X, 12..17 app shortcuts, 18 add-apps plus.
 101:     private val secItems = arrayOf(
 102:         intArrayOf(10, 5, 4, 3, 2, 1, 0, 19),
 103:         intArrayOf(9, 7, 6),
 104:         intArrayOf(18, 17, 16, 15, 14, 13, 12)
 105:     )
 106: 
 107:     // ---------------------------------------------------------------- sources
 108:     private val ids = ToggleId.values()
 109:     private val toggles = QuickToggles(ctx) { onTogglesChanged() }
 110:     private val media = MediaBridge(ctx, dp(76f).toInt()) { onMediaChanged() }
 111:     private val brightness = Brightness(ctx) { onBrightnessChanged() }
 112:     private val apps = AppShortcuts(ctx, dp(40f).toInt())
 113: 
 114:     private val tOn = BooleanArray(6)
 115:     private val tAvail = BooleanArray(6)
 116:     private val tIcon = IntArray(6)
 117: 
 118:     // ---------------------------------------------------------------- drawing objects
 119:     // One RenderNode (GPU-cached layer) per section, recorded in an unrotated frame whose corner is the
 120:     // node's bottom-right; per frame only its transform/alpha change.
 121:     private val nodes = arrayOfNulls<RenderNode>(SECTIONS)
 122:     private val dirty = BooleanArray(SECTIONS) { true }
 123:     private var nodeS = 0
 124:     private var lastDw = -1f
 125:     private var lastDh = -1f
 126:     private var lastW = -1
 127:     private var lastH = -1
 128:     private var lastTip = -1f
 129: 
 130:     private val path = Path()
 131:     private val regionPath = Path()
 132:     private val arcRect = RectF()
 133:     private val region = Region()
 134:     private val clipRegion = Region()
 135:     private val hitRegion = Region()
 136: 
 137:     // Looks (from Prefs, see applyLooksNow). Shaders are immutable at radius GR; the shape path is drawn in
 138:     // gradient-unit space under a canvas scale (never mutate a shader's local matrix per frame).
 139:     private var accent = C_RED
 140:     private var gradientPct = 60
 141:     private var rimOn = true
 142:     private var glowOn = true
 143:     private var bandsOn = false
 144:     private var hapticsOn = true
 145:     private var stiffScale = 1f
 146:     private var openDamp = 0.8f
 147:     private var idleStyleId = 1
 148:     private var vizOn = true
 149:     private var shapeShader: Shader = buildShapeShader()
 150:     private var glowShader: Shader = buildGlowShader()
 151: 
 152:     private fun mixColor(a: Int, b: Int, t: Float): Int {
 153:         val r = (Color.red(a) + (Color.red(b) - Color.red(a)) * t + 0.5f).toInt()
 154:         val g = (Color.green(a) + (Color.green(b) - Color.green(a)) * t + 0.5f).toInt()
 155:         val bl = (Color.blue(a) + (Color.blue(b) - Color.blue(a)) * t + 0.5f).toInt()
 156:         return Color.rgb(r, g, bl)
 157:     }
 158: 
 159:     private fun buildShapeShader(): Shader {
 160:         val warm = mixColor(0xFF2E1B1A.toInt(), accent or (0xFF shl 24), 0.25f)
 161:         val core = mixColor(Color.BLACK, warm, gradientPct / 100f)
 162:         return android.graphics.RadialGradient(
 163:             0f, 0f, GR,
 164:             intArrayOf(core, mixColor(Color.BLACK, core, 0.55f), mixColor(Color.BLACK, core, 0.24f), Color.BLACK),
 165:             floatArrayOf(0f, 0.38f, 0.72f, 1f), Shader.TileMode.CLAMP
 166:         )
 167:     }
 168: 
 169:     private fun buildGlowShader(): Shader {
 170:         val rgb = accent and 0xFFFFFF
 171:         return android.graphics.RadialGradient(
 172:             0f, 0f, GR,
 173:             intArrayOf((0x88 shl 24) or rgb, (0x30 shl 24) or rgb, rgb),
 174:             floatArrayOf(0f, 0.38f, 0.85f), Shader.TileMode.CLAMP
 175:         )
 176:     }
 177:     private val unitPath = Path()
 178:     private var gradScale = 1f
 179:     private val gradMatrix = Matrix()
 180:     private val shapePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
 181:         style = Paint.Style.FILL
 182:         shader = shapeShader
 183:     }
 184:     private val glowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
 185:         style = Paint.Style.FILL
 186:         shader = glowShader
 187:     }
 188:     private val rimPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
 189:         style = Paint.Style.STROKE
 190:         strokeWidth = dp(1f)
 191:         strokeCap = Paint.Cap.ROUND
 192:     }
 193:     private val ringPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
 194:         style = Paint.Style.STROKE
 195:         strokeWidth = dp(1.5f)
 196:         color = C_RED
 197:     }
 198:     private val tilePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
 199:         style = Paint.Style.FILL_AND_STROKE

 625:     private fun markItemDirty(item: Int) {
 626:         when (item) {
 627:             in 0..5, ID_ASSIST, ID_SUN -> dirty[S_QUICK] = true
 628:             6, 7, 9 -> dirty[S_MEDIA] = true
 629:             in 12..ID_PLUS -> dirty[S_APPS] = true
 630:         }
 631:     }

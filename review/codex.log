1344:     private fun drawMedia(c: Canvas, a: Float) {
1345:         val ai = (255f * a + 0.5f).toInt()
1346:         // art circle (tap = play/pause)
1347:         run {
1348:             val cx = itemCx[6]
1349:             val cy = itemCy[6]
1350:             val ps = pressed == 6
1351:             if (ps) {
1352:                 c.save()
1353:                 c.scale(PRESS_SCALE, PRESS_SCALE, cx, cy)
1354:             }
1355:             if (artBmp != null) {
1356:                 c.save()
1357:                 c.translate(cx, cy)
1358:                 artPaint.alpha = ai
1359:                 c.drawCircle(0f, 0f, artRad, artPaint)
1360:                 c.restore()
1361:             } else {
1362:                 fill.color = C_FILL
1363:                 fill.alpha = ai
1364:                 c.drawCircle(cx, cy, artRad, fill)
1365:             }
1366:             fill.color = Color.BLACK
1367:             fill.alpha = (255f * 0.42f * a + 0.5f).toInt()
1368:             c.drawCircle(cx, cy, dp(15f), fill)
1369:             val pi = icon(if (playing) R.drawable.ic_pause else R.drawable.ic_play, false)
1370:             pi.bounds = playIconRect
1371:             pi.alpha = ai
1372:             pi.draw(c)
1373:             if (ps) {
1374:                 ringPaint.alpha = ai
1375:                 c.drawCircle(cx, cy, artRad + dp(3f), ringPaint)
1376:                 c.restore()
1377:             }
1378:         }
1379:         drawBtn(c, 7, C_FILL, R.drawable.ic_skip_back, false, a, a)
1380:         drawBtn(c, 9, C_FILL, R.drawable.ic_skip_forward, false, a, a)
1381: 
1382:         // title / artist on arcs
1383:         titlePaint.alpha = ai
1384:         artistPaint.alpha = ai
1385:         timePaint.alpha = ai
1386:         c.drawTextOnPath(titleShown, titlePath, titleOff, 0f, titlePaint)
1387:         c.drawTextOnPath(artistShown, artistPath, artistOff, 0f, artistPaint)
1388: 
1389:         // progress arc
1390:         arcPaint.strokeWidth = dp(3.5f)
1391:         arcPaint.color = C_TRACK
1392:         arcPaint.alpha = ai
1393:         c.drawArc(arcOval, 180f + SL_A0, SL_A1 - SL_A0, false, arcPaint)
1394:         if (progressFrac > 0.002f) {
1395:             arcPaint.color = C_RED
1396:             arcPaint.alpha = ai
1397:             c.drawArc(arcOval, 180f + SL_A0, (SL_A1 - SL_A0) * progressFrac, false, arcPaint)
1398:         }
1399:         val ang = Math.toRadians((SL_A0 + (SL_A1 - SL_A0) * progressFrac).toDouble())
1400:         fill.color = C_RED
1401:         fill.alpha = ai
1402:         c.drawCircle(-arcR * cos(ang).toFloat(), -arcR * sin(ang).toFloat(), dp(4.5f), fill)
1403:         c.drawText(elapsedStr, elapsedX, elapsedY, timePaint)
1404:         c.drawText(totalStr, totalX, totalY, timePaint)
1405:     }

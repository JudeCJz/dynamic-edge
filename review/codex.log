            bmp.recycle()
        } catch (e: Exception) {
            bmp.eraseColor(Color.WHITE)
            android.app.WallpaperManager.getInstance(this)
                .setBitmap(bmp, null, true, android.app.WallpaperManager.FLAG_SYSTEM)
            bmp.recycle()
        } catch (e: Exception) {

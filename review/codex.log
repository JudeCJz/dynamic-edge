 739:     private fun ensureResources() {
 740:         if (resourcesReady) return
 741:         resourcesReady = true
 742:         val all = intArrayOf(
 743:             R.drawable.ic_wifi, R.drawable.ic_wifi_off, R.drawable.ic_bluetooth, R.drawable.ic_bluetooth_off,
 744:             R.drawable.ic_flashlight, R.drawable.ic_flashlight_off, R.drawable.ic_moon, R.drawable.ic_rotate,
 745:             R.drawable.ic_rotate_lock, R.drawable.ic_vibrate, R.drawable.ic_bell, R.drawable.ic_play,
 746:             R.drawable.ic_pause, R.drawable.ic_skip_back, R.drawable.ic_skip_forward, R.drawable.ic_music,
 747:             R.drawable.ic_mic
 748:         )
 749:         for (r in all) {
 750:             icon(r, false)
 751:             icon(r, true)
 752:         }
 753:     }
 754: 
 755:     private fun icon(res: Int, black: Boolean): Drawable {
 756:         val cache = if (black) blackIcons else whiteIcons
 757:         var d = cache.get(res)
 758:         if (d == null) {
 759:             d = context.getDrawable(res)!!.mutate()
 760:             d.setTint(if (black) Color.BLACK else Color.WHITE)
 761:             cache.put(res, d)
 762:         }
 763:         return d
 764:     }
 765: 
 766:     private fun ensureSources() {
 767:         if (sourcesStarted) return
 768:         sourcesStarted = true
 769:         toggles.start()
 770:         media.start()
 771:         brightness.start()
 772:         apps.load()
 773:         refreshToggles()
 774:         refreshMedia()
 775:         refreshApps()
 776:         bLevel = brightness.level()
 777:     }
 778: 
 779:     private val startSourcesRunnable = Runnable {
 780:         if (expandedTarget || dragMode != 0) {
 781:             ensureSources()
 782:             if (!userPaged && playing && page != S_MEDIA && !gestureActive) goToPage(S_MEDIA, 0f)
 783:             invalidate()
 784:         }
 785:     }
 786: 
 787:     private fun discardLayers() {
 788:         for (i in 0 until SECTIONS) {
 789:             nodes[i]?.discardDisplayList()
 790:             dirty[i] = true
 791:         }
 792:     }
 793: 
 794:     private fun stopSources() {
 795:         discardLayers()
 796:         removeCallbacks(tickRunnable)
 797:         removeCallbacks(startSourcesRunnable)
 798:         if (!sourcesStarted) return
 799:         sourcesStarted = false
 800:         toggles.stop()
 801:         media.stop()
 802:         brightness.stop()
 803:         apps.release()
 804:         for (i in 0..5) {
 805:             appBmp[i] = null
 806:             appPaint[i].shader = null
 807:         }
 808:         appCount = 0
 809:     }
 810: 
 811:     private fun onTogglesChanged() {
 812:         if (!sourcesStarted) return
 813:         refreshToggles()
 814:         invalidate()
 815:     }
 816: 
 817:     private fun onBrightnessChanged() {
 818:         if (!sourcesStarted || sliderActive) return
 819:         bLevel = brightness.level()
 820:         invalidate()
 821:     }
 822: 
 823:     private fun onMediaChanged() {
 824:         if (!sourcesStarted) return
 825:         refreshMedia()
 826:         invalidate()
 827:         if (settledExpanded && expandedTarget && page == S_MEDIA) {
 828:             removeCallbacks(tickRunnable)
 829:             if (playing) postDelayed(tickRunnable, 1000L)
 830:         }
 831:     }
 832: 
 833:     private fun refreshToggles() {
 834:         dirty[S_QUICK] = true
 835:         for (i in 0..5) {
 836:             val id = ids[i]
 837:             tOn[i] = toggles.isOn(id)
 838:             tAvail[i] = toggles.isAvailable(id)
 839:             tIcon[i] = toggles.iconRes(id)
 840:         }
 841:     }
 842: 
 843:     private fun refreshApps() {
 844:         dirty[S_APPS] = true
 845:         appCount = min(apps.count, 6)
 846:         val r = dp(20f)
 847:         for (i in 0 until 6) {
 848:             val b = if (i < appCount) apps.icon(i) else null
 849:             if (b !== appBmp[i]) {
 850:                 appBmp[i] = b
 851:                 if (b == null) {
 852:                     appPaint[i].shader = null
 853:                 } else {
 854:                     val s = BitmapShader(b, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
 855:                     appMatrix.setScale(2f * r / b.width, 2f * r / b.height)
 856:                     appMatrix.postTranslate(-r, -r)
 857:                     s.setLocalMatrix(appMatrix)
 858:                     appPaint[i].shader = s
 859:                 }
 860:             }
 861:         }
 862:     }
 863: 
 864:     private fun refreshMedia() {
 865:         dirty[S_MEDIA] = true
 866:         val has = media.hasSession
 867:         hasSession = has
 868:         val newTitle: String
 869:         val newArtist: String
 870:         if (has) {
 871:             val t = media.title
 872:             val idleSession = t.isNullOrBlank() && !media.isPlaying
 873:             newTitle = if (!t.isNullOrBlank()) t else if (idleSession) "Not playing" else "Playing"
 874:             newArtist = media.artist ?: if (idleSession) "Tap play to resume" else ""
 875:         } else {
 876:             newTitle = "Not playing"
 877:             newArtist = "Tap play to resume"
 878:         }
 879:         if (newTitle != rawTitle) {
 880:             rawTitle = newTitle
 881:             titleShown = TextUtils.ellipsize(newTitle, titlePaint, titleLen, TextUtils.TruncateAt.END).toString()
 882:             titleOff = (titleLen - titlePaint.measureText(titleShown)) / 2f
 883:         }
 884:         if (newArtist != rawArtist) {
 885:             rawArtist = newArtist
 886:             artistShown = TextUtils.ellipsize(newArtist, artistPaint, artistLen, TextUtils.TruncateAt.END).toString()
 887:             artistOff = (artistLen - artistPaint.measureText(artistShown)) / 2f
 888:         }
 889:         val b = if (has) media.art else null
 890:         if (b !== artBmp) {
 891:             artBmp = b
 892:             if (b == null) {
 893:                 artPaint.shader = null
 894:             } else {
 895:                 val s = BitmapShader(b, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
 896:                 shaderMatrix.setScale(2f * artRad / b.width, 2f * artRad / b.height)
 897:                 shaderMatrix.postTranslate(-artRad, -artRad)
 898:                 s.setLocalMatrix(shaderMatrix)
 899:                 artPaint.shader = s
 900:             }
 901:         }
 902:         playing = has && media.isPlaying
 903:         val dur = if (has) media.durationMs else 0L
 904:         val pos = if (has) media.positionMs() else 0L
 905:         progressFrac = if (dur > 0L) (pos.toFloat() / dur).coerceIn(0f, 1f) else 0f
 906:         val es = pos / 1000L
 907:         if (es != lastElapsedSec) {
 908:             lastElapsedSec = es
 909:             elapsedStr = fmt(es)
 910:         }
 911:         val ts = dur / 1000L
 912:         if (ts != lastTotalSec) {
 913:             lastTotalSec = ts
 914:             totalStr = fmt(ts)
 915:         }
 916:     }
 917: 
 918:     private fun fmt(totalSec: Long): String {
 919:         val s = if (totalSec < 0L) 0L else totalSec
 920:         sb.setLength(0)
 921:         sb.append(s / 60L).append(':')
 922:         val r = s % 60L
 923:         if (r < 10L) sb.append('0')
 924:         sb.append(r)
 925:         return sb.toString()
 926:     }

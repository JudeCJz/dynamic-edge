    private fun buildLivePath() {
        val ps = press.value
        val dw = wS.value * ps
        val dh = hS.value * ps
        val ox = width - dw
        val oy = height - dh
        if (dw == lastDw && dh == lastDh && width == lastW && height == lastH && tipPx == lastTip) return
        lastDw = dw; lastDh = dh; lastW = width; lastH = height; lastTip = tipPx
        fillPath(path, ox, oy, dw, dh, K, tipPx)
        rimPath.rewind()
        rimPath.moveTo(ox, height.toFloat())
        rimPath.cubicTo(ox, height - K * dh, width - K * dw, oy, width.toFloat(), oy)
        val r = max(dw, dh) * 1.15f / GR
        gradScale = r
    }

    override fun onDraw(c: Canvas) {
        buildLivePath()
        val g = glow
        c.save()
        c.translate(width.toFloat(), height.toFloat())
        c.scale(gradScale, gradScale)

    override fun onDraw(c: Canvas) {
        buildLivePath()
        val g = glow
        c.save()
        c.translate(width.toFloat(), height.toFloat())
        c.scale(gradScale, gradScale)
        c.drawPath(unitPath, shapePaint)
        c.translate(width.toFloat(), height.toFloat())
        c.scale(gradScale, gradScale)
        c.drawPath(unitPath, shapePaint)
        if (g > 0.01f) {
            glowPaint.alpha = (255f * g + 0.5f).toInt()
            c.drawPath(unitPath, glowPaint)
        }
        c.restore()
        if (g > 0.01f) {
            glowPaint.alpha = (255f * g + 0.5f).toInt()
            c.drawPath(unitPath, glowPaint)
        }
        c.restore()
        val ra = RIM_REST_A + (RIM_HOT_A - RIM_REST_A) * g
        val rr = (255f + (0xFF - 255f) * g).toInt()
        val rg = (255f + (0x4B - 255f) * g).toInt()
        val rb = (255f + (0x3E - 255f) * g).toInt()
        rimPaint.color = Color.argb((255f * ra + 0.5f).toInt(), rr, rg, rb)
        c.drawPath(rimPath, rimPaint)
        val a = contentAlpha
        if (a > 0.004f && resourcesReady) drawContent(c, a)
    }


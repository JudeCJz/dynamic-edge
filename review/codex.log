    private fun drawSection(c: Canvas, i: Int, a: Float) {
        tilePaint.alpha = (255f * 0.045f * a + 0.5f).toInt()
        val list = bands[i]
        for (b in list.indices) {
            val tiles = list[b]
            for (t in tiles.indices) c.drawPath(tiles[t], tilePaint)
        for (b in list.indices) {
            val tiles = list[b]
            for (t in tiles.indices) c.drawPath(tiles[t], tilePaint)
        }
        when (i) {
            S_QUICK -> drawQuick(c, a)
            S_MEDIA -> drawMedia(c, a)
            S_APPS -> drawApps(c, a)
    }

    private fun drawDots(c: Canvas, a: Float) {
        // Dots live in the free band between the close X and the inner ring, so they never
        // collide with the brightness slider / progress arc on the outer edge.
        val xd = kotlin.math.hypot(itemCx[ID_X], itemCy[ID_X])
        val rd = max(rad * 0.26f, xd + dp(26f))
        val stepDeg = Math.toDegrees((dp(10f) / rd).toDouble()).toFloat()
    }


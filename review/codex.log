 330:     private fun addSwatches(parent: LinearLayout) {
 331:         val row = LinearLayout(this).apply {
 332:             orientation = LinearLayout.HORIZONTAL
 333:             gravity = Gravity.CENTER_VERTICAL
 334:             setPadding(dp(20), dp(14), dp(20), dp(14))
 335:         }
 336:         val cur = Prefs.accent(this)
 337:         val dots = ArrayList<View>()
 338:         fun mark(sel: Int) {
 339:             for ((i, v) in dots.withIndex()) {
 340:                 val c = Prefs.ACCENTS[i]
 341:                 v.background = GradientDrawable().apply {
 342:                     shape = GradientDrawable.OVAL
 343:                     setColor(c)
 344:                     if (c == sel) setStroke(dp(2), Color.WHITE) else setStroke(0, Color.TRANSPARENT)
 345:                 }
 346:             }
 347:         }
 348:         for ((i, c) in Prefs.ACCENTS.withIndex()) {
 349:             val v = View(this).apply {
 350:                 isClickable = true
 351:                 setOnClickListener {
 352:                     edit().putInt(Prefs.KEY_ACCENT, c).apply()
 353:                     mark(c)
 354:                     applyAccent(c)
 355:                     performHapticFeedback(android.view.HapticFeedbackConstants.CLOCK_TICK)
 356:                 }
 357:             }
 358:             dots.add(v)
 359:             row.addView(v, LinearLayout.LayoutParams(dp(28), dp(28)))
 360:             if (i < Prefs.ACCENTS.size - 1) {
 361:                 row.addView(View(this), LinearLayout.LayoutParams(0, 1, 1f))
 362:             }
 363:         }
 364:         mark(cur)
 365:         parent.addView(row, matchWrap())
 366:         parent.addView(line(), LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 1))
 367:     }
 368: 
 369:     private fun addIdleStyles(parent: LinearLayout) {
 370:         val row = LinearLayout(this).apply {
 371:             orientation = LinearLayout.HORIZONTAL
 372:             gravity = Gravity.CENTER_VERTICAL
 373:             setPadding(dp(20), dp(14), dp(20), dp(14))
 374:         }
 375:         val cur = Prefs.idleStyle(this)
 376:         val mine = ArrayList<IdlePreview>()
 377:         for ((i, st) in Prefs.IDLE_STYLES.withIndex()) {
 378:             val p = IdlePreview(this, st).apply {
 379:                 accent = Prefs.accent(this@MainActivity)
 380:                 gradient = Prefs.gradient(this@MainActivity)
 381:                 selectedStyle = st == cur
 382:                 isClickable = true
 383:                 setOnClickListener {
 384:                     edit().putString(Prefs.KEY_IDLE_STYLE, st).apply()
 385:                     mine.forEach { it.selectedStyle = it === this }
 386:                 }
 387:             }
 388:             mine.add(p)
 389:             previews.add(p)
 390:             row.addView(p)
 391:             if (i < Prefs.IDLE_STYLES.size - 1) {
 392:                 row.addView(View(this), LinearLayout.LayoutParams(0, 1, 1f))
 393:             }
 394:         }
 395:         parent.addView(row, matchWrap())
 396:         parent.addView(line(), LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 1))
 397:     }
 398: 
 399:     private fun addRow(parent: LinearLayout, label: String, check: () -> Boolean, intent: () -> Intent) {
 400:         val row = LinearLayout(this).apply {
 401:             orientation = LinearLayout.HORIZONTAL
 402:             gravity = Gravity.CENTER_VERTICAL
 403:             setPadding(dp(20), dp(16), dp(20), dp(16))
 404:             isClickable = true
 405:             background = ripple()
 406:         }
 407:         val name = text(label, 16f, white, Typeface.DEFAULT)
 408:         val state = text("Off", 14f, grey, Typeface.DEFAULT)
 409:         row.addView(name, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
 410:         row.addView(state, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
 411:         row.setOnClickListener {
 412:             try {
 413:                 startActivity(intent())
 414:             } catch (e: Exception) {
 415:             }
 416:         }
 417:         parent.addView(row, matchWrap())
 418:         parent.addView(line(), LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 1))
 419:         rows.add(Row(state, check))
 420:     }

1407:     private fun drawApps(c: Canvas, a: Float) {
1408:         if (appCount == 0) {
1409:             val cx = itemCx[ID_PLUS]
1410:             val cy = itemCy[ID_PLUS]
1411:             val ps = pressed == ID_PLUS
1412:             val ai = (255f * a + 0.5f).toInt()
1413:             if (ps) {
1414:                 c.save()
1415:                 c.scale(PRESS_SCALE, PRESS_SCALE, cx, cy)
1416:                 ringPaint.alpha = ai
1417:                 c.drawCircle(cx, cy, itemRad[ID_PLUS], ringPaint)
1418:             }
1419:             linePaint.color = C_GREY
1420:             linePaint.alpha = ai
1421:             linePaint.strokeWidth = dp(2f)
1422:             val h = dp(9f)
1423:             c.drawLine(cx - h, cy, cx + h, cy, linePaint)
1424:             c.drawLine(cx, cy - h, cx, cy + h, linePaint)
1425:             if (ps) c.restore()
1426:             return
1427:         }
1428:         for (k in 0 until appCount) {
1429:             val i = 12 + k
1430:             val cx = itemCx[i]
1431:             val cy = itemCy[i]
1432:             val ps = pressed == i
1433:             c.save()
1434:             c.translate(cx, cy)
1435:             if (ps) c.scale(PRESS_SCALE, PRESS_SCALE)
1436:             val p = appPaint[k]
1437:             if (p.shader != null) {
1438:                 // white disc behind, so square/legacy icons don't show transparent corners
1439:                 fill.color = Color.WHITE
1440:                 fill.alpha = (255f * a + 0.5f).toInt()
1441:                 c.drawCircle(0f, 0f, dp(20f), fill)
1442:                 p.alpha = (255f * a + 0.5f).toInt()
1443:                 c.drawCircle(0f, 0f, dp(20f), p)
1444:             }
1445:             if (ps) {
1446:                 ringPaint.alpha = (255f * a + 0.5f).toInt()
1447:                 c.drawCircle(0f, 0f, dp(23f), ringPaint)
1448:             }
1449:             c.restore()
1450:         }
1451:     }

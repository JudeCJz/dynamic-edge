private fun drawIdle(c: Canvas, ia: Float) {
        val sc = idle / dp(48f)
        c.save()
        c.translate(width.toFloat(), height.toFloat())
        val ps = press.value
        c.scale(ps, ps)
        val cen = -0.4244f * idle
        if (vizOn && idlePlaying) {
            val bw = dp(2.5f) * sc
            val pitch = dp(4.5f) * sc
            val minH = dp(3f) * sc
            val maxH = 0.34f * idle
            val lv = visualizer.levels
            for (i in 0 until 4) {
                val h = minH + (maxH - minH) * lv[i]
                val x = cen + (i - 1.5f) * pitch
                fill.color = if (i == 2) accent else Color.WHITE
                fill.alpha = (255f * 0.85f * ia + 0.5f).toInt()
                c.drawRoundRect(x - bw / 2f, cen - h / 2f, x + bw / 2f, cen + h / 2f, bw / 2f, bw / 2f, fill)
            }
        } else when (idleStyleId) {
            1 -> {
                fill.color = accent
                fill.alpha = (255f * ia + 0.5f).toInt()
                c.drawCircle(-0.30f * idle, -0.30f * idle, dp(2f) * sc, fill)
            }
            2 -> {
                val r = 0.70f * idle
                idleRect.set(-r, -r, r, r)
                idlePaint.strokeWidth = dp(1.4f) * sc
                idlePaint.color = C_CREAM
                idlePaint.alpha = (255f * 0.85f * ia + 0.5f).toInt()
                c.drawArc(idleRect, 180f + 12f, 66f, false, idlePaint)
            }
            3 -> {
                val r = 0.66f * idle
                idleRect.set(-r, -r, r, r)
                idlePaint.strokeWidth = dp(2.6f) * sc
                idlePaint.color = Color.WHITE
                idlePaint.alpha = (255f * 0.22f * ia + 0.5f).toInt()
                c.drawArc(idleRect, 180f + 10f, 70f, false, idlePaint)
                if (battFrac > 0.01f) {
                    idlePaint.color = if (charging) Color.WHITE else accent
                    idlePaint.alpha = (255f * 0.9f * ia + 0.5f).toInt()
                    c.drawArc(idleRect, 180f + 10f, 70f * battFrac, false, idlePaint)
                }
                if (charging) {
                    val u = 0.07f * idle
                    boltPath.rewind()
                    boltPath.moveTo(cen + 0.3f * u, cen - u)
                    boltPath.lineTo(cen - 0.5f * u, cen + 0.1f * u)
                    boltPath.lineTo(cen, cen + 0.1f * u)
                    boltPath.lineTo(cen - 0.3f * u, cen + u)
                    boltPath.lineTo(cen + 0.5f * u, cen - 0.1f * u)
                    boltPath.lineTo(cen, cen - 0.1f * u)
                    boltPath.close()
                    fill.color = Color.WHITE
                    fill.alpha = (255f * 0.85f * ia + 0.5f).toInt()
                    c.drawPath(boltPath, fill)
                }
            }
            4 -> if (clockStr.isNotEmpty()) {
                clockPaint.textSize = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, 10f, resources.displayMetrics) * sc
                clockPaint.alpha = (255f * 0.85f * ia + 0.5f).toInt()
                c.drawText(clockStr, cen, cen - (clockPaint.ascent() + clockPaint.descent()) / 2f, clockPaint)
            }
        }
        c.restore()
    }

    // ================================================================ live activities

    private fun onTrackChanged(title: String?) {
        if (!liveOn || expandedTarget || !screenOn || hidden || title.isNullOrBlank()) return
        if (title == lastLiveTrack) return
        lastLiveTrack = title
        putTransient(
            LiveActivity(
                "media", LiveActivity.Kind.MEDIA, title.take(40), -1f, 0L, false,
                R.drawable.ic_music, false, null, null, null
            ), 3000L
        )
    }

    /** Posts a transient activity and removes it after [ms]. */
    private fun putTransient(a: LiveActivity, ms: Long) {
        val old = transientRunnables.remove(a.key)
        if (old != null) removeCallbacks(old)
        val key = a.key
        val r = Runnable {
            transientRunnables.remove(key)
            LiveBus.remove(key)
        }
        transientRunnables[key] = r
        postDelayed(r, ms)
        LiveBus.put(a)
    }

    private fun scheduleTransient(a: LiveActivity?) {
        if (a == null || a.ongoing || transientRunnables.containsKey(a.key)) return
        val key = a.key
        val ms = when (a.kind) {
            LiveActivity.Kind.MEDIA -> 3000L
            LiveActivity.Kind.CHARGING -> 3500L
            else -> 4000L
        }
        val r = Runnable {
            transientRunnables.remove(key)
            LiveBus.remove(key)
        }
        transientRunnables[key] = r
        postDelayed(r, ms)
    }

    private fun onLiveChanged() {
        val top = if (liveOn) LiveBus.top() else null
        val sec = if (liveOn) LiveBus.second() else null
        liveCur = top
        liveSec = sec
        scheduleTransient(top)
        scheduleTransient(sec)
        if (top?.key != liveTitleKey) {
            liveTitleKey = top?.key
            liveTitleRaw = null
            liveTotalMs = 0L
            if (top != null && top.countDown && top.chronoBase != 0L) {
                liveTotalMs = max(1000L, top.chronoBase - System.currentTimeMillis())
            }
        }
        rebuildLiveTitle()
        syncClosedSize()
        updateViz()
        syncLiveTick()
        invalidateBean()
    }


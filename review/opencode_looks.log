    private fun allSettled(): Boolean =
        wS.isSettled(0.3f, 15f) && hS.isSettled(0.3f, 15f) &&
            pageS.isSettled(0.002f, 0.05f) && press.isSettled(0.002f, 0.1f)

    private fun finishSettle() {
        if (expandedTarget) {
            regionExpanded = true
            settledExpanded = true
            publishRegion()
            host?.onSettled(true)
            removeCallbacks(tickRunnable)
            if (playing && page == S_MEDIA && screenOn && !hidden) postDelayed(tickRunnable, 1000L)
            if (Math.round(pageS.value) == S_CLIP && !hidden) requestCapture()
        } else {
            regionExpanded = false
            settledExpanded = false
            stopSources()
            regionClosed = closedSize()
            publishRegion()
            host?.onSettled(false)
            if (idleStyleId == 3 && screenOn) readBattery()
            updateViz()
            syncLiveTick()
            syncClosedSize()
            invalidateBean()
        }
    }

    private fun updateDerived(dt: Float) {
        val span = max(rad - idle, 1f)
        val p = min((wS.value - idle) / span, (hS.value - idle) / span).coerceIn(0f, 1f)
        progress = p
        val t = ((p - 0.55f) / 0.40f).coerceIn(0f, 1f)
        val sm = t * t * (3f - 2f * t)
        contentAlpha = if (collapsing) {
            min(sm, max(0f, contentAlpha - dt / 0.09f))
        } else {
            sm
        }
    }

    // ================================================================ draw

    private fun buildLivePath() {
        val pulse = if (beatOn && vizRunning) 1f + beat * (if (expandedTarget) 0.015f else 0.06f) else 1f
        val ps = press.value * pulse
        val dw = wS.value * ps
        val dh = hS.value * ps
        val ox = width - dw
        val oy = height - dh
        val pressGlow = ((1f - press.value) / (1f - PRESS_SCALE)).coerceIn(0f, 1f)
        glow = max(max(pressGlow, if (dragMode != 0 || arcDrag >= 0) 0.85f else 0f), max(progress * 0.4f, if (beatOn && vizRunning) beat * 0.55f else 0f))
        // Static shape: keep the Path objects untouched so HWUI reuses their cached geometry.
        if (dw == lastDw && dh == lastDh && width == lastW && height == lastH && tipPx == lastTip) return
        lastDw = dw; lastDh = dh; lastW = width; lastH = height; lastTip = tipPx
        fillPath(path, ox, oy, dw, dh, K, tipPx)
        rimPath.rewind()
        rimPath.moveTo(ox, height.toFloat())
        rimPath.cubicTo(ox, height - K * dh, width - K * dw, oy, width.toFloat(), oy)
        val r = max(dw, dh) * 1.15f / GR
        gradScale = r
        gradMatrix.setTranslate(-width.toFloat(), -height.toFloat())
        gradMatrix.postScale(1f / r, 1f / r)
        path.transform(gradMatrix, unitPath)
    }

    override fun onDraw(c: Canvas) {
        buildLivePath()
        val g = glow
        c.save()
        c.translate(width.toFloat(), height.toFloat())
        c.scale(gradScale, gradScale)
        c.drawPath(unitPath, shapePaint)
        if (glowOn && g > 0.01f) {
            glowPaint.alpha = (255f * g + 0.5f).toInt()
            c.drawPath(unitPath, glowPaint)
        }
        c.restore()
        if (rimOn) {
            val ra = RIM_REST_A + (RIM_HOT_A - RIM_REST_A) * g
            rimPaint.color = (mixColor(Color.WHITE, accent, g) and 0xFFFFFF) or ((255f * ra + 0.5f).toInt() shl 24)
            c.drawPath(rimPath, rimPaint)
        }
        val ia = 1f - progress * 3f
        if (liveWanted && !expandedTarget) {
            drawLive(c)
        } else if (ia > 0.01f && !liveWanted) {
            drawIdle(c, ia)
        }
        val a = contentAlpha
        if (a > 0.004f && resourcesReady) drawContent(c, a)
    }

    private fun drawContent(c: Canvas, a: Float) {
        if (!c.isHardwareAccelerated) {
            drawContentDirect(c, a)
            return
        }
        val off = (1f - a) * dp(16f)
        // content grows with the melting shape, so no clip is needed
        val cs = (min(wS.value, hS.value) / rad).coerceIn(0f, 1f)
        val pos = pageS.value
        val s = nodeS
        val sf = s.toFloat()
        val w = width
        val h = height
        if (beatOn && vizRunning && beat > 0.03f && abs(pos - S_MEDIA) < 0.6f) {
            val fa = pageFade(pos - S_MEDIA)
            c.save()
            c.translate(w + off, h + off)
            c.scale(cs, cs)
            c.rotate((S_MEDIA - pos) * PAGE_DEG)
            arcPaint.color = accent
            arcPaint.strokeWidth = dp(5f) + beat * dp(5f)
            arcPaint.alpha = (255f * 0.38f * beat * a * fa + 0.5f).toInt()
            c.drawCircle(itemCx[ID_ART], itemCy[ID_ART], artRad + dp(3f) + beat * dp(5f), arcPaint)
            c.restore()
        }
        for (i in 0 until SECTIONS) {
            val d = i - pos
            val fa = pageFade(d)
            if (fa <= 0.004f) continue
            var n = nodes[i]
            if (n == null) {
                n = RenderNode("edgeSection$i")
                n.setUseCompositingLayer(true, null)
                n.setClipToBounds(true)
                nodes[i] = n
            }
            n.setPosition(w - s, h - s, w, h)
            if (dirty[i]) {
                val rc = n.beginRecording(s, s)
                try {
                    rc.translate(sf, sf)
                    drawSection(rc, i, 1f)
                } finally {
                    n.endRecording()
                }
                dirty[i] = false
            }
            n.setPivotX(sf)
            n.setPivotY(sf)
            n.setRotationZ(d * PAGE_DEG)
            n.setAlpha(a * fa)
            n.setScaleX(cs)
            n.setScaleY(cs)
            n.setTranslationX(off)
            n.setTranslationY(off)
            c.drawRenderNode(n)
        }
        c.save()
        c.translate(w + off, h + off)
        c.scale(cs, cs)
        drawPageBars(c, a)
        drawClose(c, a)
        c.restore()
    }

